        { create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }) })

    local main = create("Frame", { Name = "Main", BackgroundColor3 = C.Window, Size = UDim2.fromOffset(W, H), Position = UDim2.new(0.5, 0, 0.5, 20), AnchorPoint = Vector2.new(0.5, 0.5), Parent = gui }, { corner(10), stroke() })

    Window.IsMobile = cfg.Mobile
    if Window.IsMobile == nil then Window.IsMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled end
    if cfg.Intro ~= false then
        Window._intro = true
        main.Visible = false
        task.spawn(function()
            local accent, tip, tail = Library.Theme.Accent, Library.Theme.StreakTip, Library.Theme.StreakTail
            local card = create("CanvasGroup", { BackgroundColor3 = C.Panel, Size = UDim2.fromOffset(320, 150), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 14), GroupTransparency = 1, ZIndex = 90, Parent = gui }, { corner(16), stroke() })
            local cScale = create("UIScale", { Scale = 0.96, Parent = card })
            local tag = label({ Text = "I N I T I A L I Z I N G", Font = FONT_MED, TextSize = 10, TextColor3 = accent, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 12), ZIndex = 91, Parent = card })

            local title = tostring(cfg.Title or "Hub")
            local row = create("Frame", { BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), ZIndex = 91, Parent = card },
                { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 1), SortOrder = Enum.SortOrder.LayoutOrder }) })
            local letters = {}
            for i = 1, #title do
                local ch = title:sub(i, i)
                local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(ch == " " and 7 or 0, 30), AutomaticSize = ch == " " and Enum.AutomaticSize.None or Enum.AutomaticSize.X, LayoutOrder = i, ZIndex = 91, Parent = row })
                local l = label({ Text = ch, Font = FONT_BOLD, TextSize = 24, TextTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30), Position = UDim2.fromOffset(0, 12), ZIndex = 92, Parent = holder })
                letters[i] = l
            end
            local barBack = create("Frame", { BackgroundColor3 = C.Element, BorderSizePixel = 0, Size = UDim2.new(1, -52, 0, 4), Position = UDim2.fromOffset(26, 96), ClipsDescendants = true, ZIndex = 91, Parent = card }, { corner(2) })
            local bar = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 92, Parent = barBack }, { corner(2),
                create("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, tail), ColorSequenceKeypoint.new(0.6, accent), ColorSequenceKeypoint.new(1, tip) }) }) })
            local shine = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromOffset(60, 4), Position = UDim2.fromOffset(-60, 0), ZIndex = 93, Parent = barBack },
                { create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.45), NumberSequenceKeypoint.new(1, 1) }) }) })
            local status = label({ Text = "Starting...", TextSize = 12, TextColor3 = C.Muted, Position = UDim2.fromOffset(26, 110), Size = UDim2.new(0.6, 0, 0, 16), ZIndex = 91, Parent = card })
            local pct = label({ Text = "0%", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -26, 0, 110), Size = UDim2.fromOffset(60, 16), ZIndex = 91, Parent = card })

            tween(card, 0.5, { GroupTransparency = 0, Position = UDim2.fromScale(0.5, 0.5) })
            tween(cScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
            for i, l in ipairs(letters) do
                task.delay(0.2 + i * 0.05, function()
                    tween(l, 0.45, { TextTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
                end)
            end
            local LABELS = { { 0, "Starting..." }, { 20, "Loading library..." }, { 45, "Building interface..." }, { 75, "Loading settings..." }, { 100, "Ready" } }
            local DELAY, FILL = 0.2, 0.9
            local t0 = os.clock()
            local done = false
            local stepConn
            stepConn = RunService.RenderStepped:Connect(function()
                local t = os.clock() - t0
                tag.TextTransparency = 0.35 + 0.35 * math.cos(t * 4.5)
                shine.Position = UDim2.new((t % 1.1) / 1.1, -60, 0, 0)
                if done then return end
                local k = math.clamp((t - DELAY) / FILL, 0, 1)
                local p = (1 - (1 - k) ^ 3) * 100
                bar.Size = UDim2.fromScale(p / 100, 1)
                pct.Text = math.floor(p + 0.5) .. "%"
                local txt = LABELS[1][2]
                for _, lb in ipairs(LABELS) do if p >= lb[1] then txt = lb[2] end end
                status.Text = txt
                if k >= 1 then done = true end
            end)
            task.wait(1.45)
            tween(cScale, 0.45, { Scale = 2.4 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tween(card, 0.4, { GroupTransparency = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            task.wait(0.3)
            if gui.Parent then
                main.Visible = true
                main.Position = UDim2.new(0.5, 0, 0.5, 20)
                tween(main, 0.55, { Position = UDim2.fromScale(0.5, 0.5) })
            end
            Window._intro = false
            task.wait(0.15)
            stepConn:Disconnect()
            card:Destroy()
        end)
    else
        tween(main, 0.45, { Position = UDim2.fromScale(0.5, 0.5) })
    end
    Window.Main = main
    local function conn(c) table.insert(Window.Connections, c) return c end

    local streaks = {}
    for i = 1, 3 do
        local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = main }, { corner(10) })

        local st = create("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = holder })
        local gr = create("UIGradient", {
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.8, 1), NumberSequenceKeypoint.new(0.88, 0.8),
                NumberSequenceKeypoint.new(0.95, 0.25), NumberSequenceKeypoint.new(0.99, 0), NumberSequenceKeypoint.new(1, 0.4),
            }),
            Parent = st,
        })
        table.insert(streaks, { Holder = holder, Gradient = gr, Offset = (i - 1) * 120 })
    end
    bindTheme(function(t)
        if not main.Parent then error("gone") end
        for _, s in ipairs(streaks) do
            s.Gradient.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, t.StreakTail), ColorSequenceKeypoint.new(0.88, t.StreakTail),
                ColorSequenceKeypoint.new(0.95, t.Streak), ColorSequenceKeypoint.new(1, t.StreakTip),
            })
            s.Holder.Visible = t.Lines
        end
    end)
    local rot = 0
    conn(RunService.RenderStepped:Connect(function(dt)
        if not Library.Theme.Lines or not main.Visible then return end
        rot = (rot + 360 / math.max(Library.Theme.LapTime, 1) * dt) % 360
        for _, s in ipairs(streaks) do s.Gradient.Rotation = (rot + s.Offset) % 360 end
    end))

    local top = create("Frame", { BackgroundColor3 = C.Top, Size = UDim2.new(1, 0, 0, TOP), Parent = main }, { corner(10) })
    create("Frame", { BackgroundColor3 = C.Top, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, -10), Parent = top })
    create("Frame", { BackgroundColor3 = C.Line, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, TOP), Parent = main })
    local titleLbl = label({ Text = cfg.Title or "Hub", Font = FONT_BOLD, TextSize = 16, Position = UDim2.fromOffset(20, 0), Size = UDim2.new(0, 220, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = top })

    local minBtn = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Hover, BackgroundTransparency = 1, Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -46, 0.5, 0), Parent = top }, { corner(6) })
    local minBar = create("Frame", { BackgroundColor3 = C.SubText, BorderSizePixel = 0, Size = UDim2.fromOffset(12, 2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Parent = minBtn }, { corner(1) })
    local closeBtn = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Hover, BackgroundTransparency = 1, Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Parent = top }, { corner(6) })
