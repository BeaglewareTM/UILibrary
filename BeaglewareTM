    create("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size * 0.42, t), Position = UDim2.new(0.3, 0, 0.62, 0), Rotation = 45, Parent = h }, { corner(1) })
    create("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size * 0.78, t), Position = UDim2.new(0.6, 0, 0.47, 0), Rotation = -50, Parent = h }, { corner(1) })
