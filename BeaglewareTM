        Section._open = function() if not open then open = true panel:Set(true) tween(arrow, 0.25, { Rotation = 0 }) tween(divider, 0.2, { BackgroundTransparency = 0 }) end end

        local ctx = { Window = Window, Page = page, Section = scfg.Name or "Section", SectionObj = Section, Owner = owner }
        for ename, fn in pairs(Elements) do
            Section["Add" .. ename] = function(_, ecfg) return fn(bodyFrame, ctx, ecfg or {}) end
        end

        local SHORT = {
            Button        = { "Button",      function(n, cb, notify) return { Name = n, Callback = cb, Notify = notify } end },
            Toggle        = { "Toggle",      function(n, def, cb, desc) return { Name = n, Default = def, Callback = cb, Description = desc } end },
            Checkbox      = { "Checkbox",    function(n, def, cb) return { Name = n, Default = def, Callback = cb } end },
            Slider        = { "Slider",      function(n, mn, mx, def, cb) return { Name = n, Min = mn, Max = mx, Default = def, Callback = cb } end },
            Dropdown      = { "Dropdown",    function(n, opts, cb, def) return { Name = n, Options = opts, Callback = cb, Default = def } end },
            MultiDropdown = { "Dropdown",    function(n, opts, cb, def) return { Name = n, Options = opts, Callback = cb, Default = def, Multi = true } end },
            Textbox       = { "Textbox",     function(n, ph, cb) return { Name = n, Placeholder = ph, Callback = cb } end },
            Keybind       = { "Keybind",     function(n, key, cb) return { Name = n, Default = key, Callback = cb } end },
            ColorPicker   = { "ColorPicker", function(n, def, cb) return { Name = n, Default = def, Callback = cb } end },
            Label         = { "Label",       function(t) return { Text = t } end },
            Paragraph     = { "Paragraph",   function(t, c) return { Title = t, Content = c } end },
            ProgressBar   = { "ProgressBar", function(n, def) return { Name = n, Default = def } end },
            Info          = { "Info",        function(n, v) return { Name = n, Value = v } end },
            Chart         = { "Chart",       function(n, mn, mx, unit) return { Name = n, Min = mn, Max = mx, Unit = unit } end },
        }
        for short, def in pairs(SHORT) do
            local fn, toCfg = Elements[def[1]], def[2]
            Section[short] = function(_, a, ...)
                if typeof(a) == "table" then
                    if short == "MultiDropdown" then a.Multi = true end
                    return fn(bodyFrame, ctx, a)
                end
                return fn(bodyFrame, ctx, toCfg(a, ...))
            end
