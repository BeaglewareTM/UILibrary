local themeBinds = {}
local function bindTheme(fn)
    table.insert(themeBinds, fn)
    fn(Library.Theme)
end
local function fireTheme()
    for i = #themeBinds, 1, -1 do
        local ok = pcall(themeBinds[i], Library.Theme)
        if not ok then table.remove(themeBinds, i) end
    end
end

local FONT, FONT_MED, FONT_BOLD = Enum.Font.Gotham, Enum.Font.GothamMedium, Enum.Font.GothamBold

local paintReg = setmetatable({}, { __mode = "k" })
local alphaReg = setmetatable({}, { __mode = "k" })
local textReg = setmetatable({}, { __mode = "k" })
local COLOR_PROPS = { "BackgroundColor3", "TextColor3", "Color", "PlaceholderColor3", "ScrollBarImageColor3" }
local textFx = { Style = "Solid", Second = Color3.fromRGB(255, 126, 185), Direction = 90, Hue = 0 }

local function roleOf(v)
    for _, r in ipairs(ROLES) do if C[r] == v then return r end end
    return nil
end
local function applyTextFx(obj)
    local g = obj:FindFirstChild("_TextFx")
    if textFx.Style == "Solid" then
        if g then g:Destroy() end
        obj.TextColor3 = C.Text
        return
    end
    obj.TextColor3 = Color3.new(1, 1, 1)
    if not g then
        g = Instance.new("UIGradient")
        g.Name = "_TextFx"
        g.Parent = obj
    end
    if textFx.Style == "Gradient" then
        g.Color = ColorSequence.new(C.Text, textFx.Second)
        g.Rotation = textFx.Direction - 90
    else
        g.Color = ColorSequence.new(Color3.fromHSV(textFx.Hue, 0.55, 1))
        g.Rotation = 0
    end
end
local function track(obj, props)
    for _, k in ipairs(COLOR_PROPS) do
        local v = props[k]
        if typeof(v) == "Color3" then
            local r = roleOf(v)
            if r then
                paintReg[obj] = paintReg[obj] or {}
                paintReg[obj][k] = r
                if k == "BackgroundColor3" and GLASS_ROLES[r] and (props.BackgroundTransparency == nil or props.BackgroundTransparency == 0) then
                    alphaReg[obj] = { "BackgroundTransparency", r }
                    obj.BackgroundTransparency = Alpha[r]
                elseif k == "Color" and STROKE_ROLES[r] and obj:IsA("UIStroke") and (props.Transparency == nil or props.Transparency == 0) then
                    alphaReg[obj] = { "Transparency", r }
                    obj.Transparency = Alpha[r]
                elseif k == "TextColor3" and r == "Text" then
                    textReg[obj] = true
                    if textFx.Style ~= "Solid" then applyTextFx(obj) end
                end
            end
        end
    end
end

local function create(class, props, children)
    local obj = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else obj[k] = v end
    end
    if props then track(obj, props) end
    for _, c in ipairs(children or {}) do c.Parent = obj end
    if parent then obj.Parent = parent end
    return obj
end

local function applyPalette()
    local ap = Library.Appearance
    local pal = BUILTIN_PALETTES[ap.Mode]
    if not pal then pal = customPalette(ap.Mode == "Custom" and ap.Custom or THEME_PRESETS[ap.Mode] or CUSTOM_DEFAULT) end
    local used = { [tostring(Color3.new(1, 1, 1))] = true, [tostring(Color3.new(0, 0, 0))] = true, [tostring(C.Dark)] = true }
    for _, r in ipairs(ROLES) do
        local base = pal[r][1]
        local c, step = base, 0
        local R, G, B = math.floor(base.R * 255 + 0.5), math.floor(base.G * 255 + 0.5), math.floor(base.B * 255 + 0.5)
        while used[tostring(c)] do
            step += 1
            local d = (step % 2 == 1) and -math.ceil(step / 2) or math.ceil(step / 2)
            c = Color3.fromRGB(math.clamp(R + d, 0, 255), math.clamp(G + d, 0, 255), B)
        end
        used[tostring(c)] = true
        C[r] = c
        Alpha[r] = pal[r][2]
    end
    local cu = ap.Mode == "Custom" and ap.Custom or nil
    textFx.Style = cu and cu.TextStyle or "Solid"
    textFx.Second = cu and hex(cu.SecondColor) or textFx.Second
    textFx.Direction = cu and tonumber(cu.Direction) or 90
    for obj, props in pairs(paintReg) do
        pcall(function() for k, r in pairs(props) do obj[k] = C[r] end end)
    end
    for obj, a in pairs(alphaReg) do
        pcall(function() obj[a[1]] = Alpha[a[2]] end)
    end
    for obj in pairs(textReg) do pcall(applyTextFx, obj) end
end

RunService.RenderStepped:Connect(function(dt)
    if textFx.Style ~= "RGB" then return end
    textFx.Hue = (textFx.Hue + dt / 3) % 1
    local seq = ColorSequence.new(Color3.fromHSV(textFx.Hue, 0.55, 1))
    for obj in pairs(textReg) do
        local g = obj.Parent and obj:FindFirstChild("_TextFx")
        if g then g.Color = seq end
    end
end)

function Library:SetTheme(key, value) self.Theme[key] = value fireTheme() end
function Library:SetAppearance(mode, custom)
    if custom then self.Appearance.Custom = custom end
    if mode then self.Appearance.Mode = mode end
    local src = THEME_PRESETS[self.Appearance.Mode] or (self.Appearance.Mode == "Custom" and self.Appearance.Custom)
    if src then
        local ac = hex(src.Accent)
        if ac then self.Theme.Accent, self.Theme.Streak = ac, ac end
    elseif self._lastMode and (THEME_PRESETS[self._lastMode] or self._lastMode == "Custom") then
        self.Theme.Accent, self.Theme.Streak = DEFAULT_THEME.Accent, DEFAULT_THEME.Streak
    end
    self._lastMode = self.Appearance.Mode
    applyPalette()
    fireTheme()
end
function Library:ResetTheme()
    for k, v in pairs(DEFAULT_THEME) do self.Theme[k] = v end
    self.Appearance.Mode = "Dark"
    self.Appearance.Custom = table.clone(CUSTOM_DEFAULT)
    applyPalette()
    fireTheme()
end

