        local col = page.Columns[scfg.Side == "Right" and 2 or 1]
        local card = create("Frame", { BackgroundColor3 = C.Card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(col), Parent = col }, { corner(8), stroke(), list(0) })
