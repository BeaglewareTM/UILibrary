local function customPalette(cu)
    local function g(k) return hex(cu[k]) or hex(CUSTOM_DEFAULT[k]) end
    local win, el, tx, st, sb, cd = g("Window"), g("Element"), g("Text"), g("Outline"), g("FadedText"), g("Section")
    local a = math.clamp((tonumber(cu.Transparency) or 0) / 100, 0, 0.9)
    local glass = a > 0
    return {
        Window = { win, a }, Top = { g("Top"), glass and 1 or 0 }, Side = { g("Side"), glass and 1 or 0 },
        Card = { cd, glass and (1 - math.max(0.08, (1 - a) * 0.55)) or 0 }, Panel = { cd, glass and math.min(a, 0.3) or 0 },
        Element = { el, glass and (1 - math.max(0.12, (1 - a) * 0.7)) or 0 },
        Hover = { el:Lerp(tx, 0.07), 0 }, Active = { el:Lerp(tx, 0.1), 0 }, Stroke = { st, 0 }, Line = { st:Lerp(win, 0.4), 0 },
        Text = { tx, 0 }, SubText = { sb, 0 }, Muted = { sb:Lerp(win, 0.12), 0 }, Faint = { sb:Lerp(win, 0.25), 0 },
    }
end

