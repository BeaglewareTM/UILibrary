local themeBinds = {}
local function bindTheme(fn)
    table.insert(themeBinds, fn)
    fn(Library.Theme)
end
local function fireTheme()
    for i = #themeBinds, 1, -1 do
        local ok = pcall(themeBinds[i], Library.Theme)
        if not ok then table.remove(themeBinds, i) end
    end
end
function Library:SetTheme(key, value) self.Theme[key] = value fireTheme() end
function Library:ResetTheme() for k, v in pairs(DEFAULT_THEME) do self.Theme[k] = v end fireTheme() end

local FONT, FONT_MED, FONT_BOLD = Enum.Font.Gotham, Enum.Font.GothamMedium, Enum.Font.GothamBold

local function create(class, props, children)
    local obj = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else obj[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = obj end
    if parent then obj.Parent = parent end
    return obj
end
local function corner(r) return create("UICorner", { CornerRadius = UDim.new(0, r or 6) }) end
local function stroke(color, thick, trans)
    return create("UIStroke", { Color = color or C.Stroke, Thickness = thick or 1, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function pad(t, r, b, l)
    return create("UIPadding", { PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r or t), PaddingBottom = UDim.new(0, b or t), PaddingLeft = UDim.new(0, l or r or t) })
end
local function list(gap, dir)
    return create("UIListLayout", { Padding = UDim.new(0, gap or 0), FillDirection = dir or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder })
end
local function tween(obj, t, props, style, dir)
    local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function nextOrder(parent)
    local n = (parent:GetAttribute("_n") or 0) + 1
    parent:SetAttribute("_n", n)
    return n
end
local function label(props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or FONT
    props.TextColor3 = props.TextColor3 or C.Text
    props.TextSize = props.TextSize or 14
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
    return create("TextLabel", props)
end
local function toHex(c) return string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
local function fromHex(h)
    h = tostring(h or ""):gsub("#", "")
    if #h == 3 then h = h:sub(1, 1):rep(2) .. h:sub(2, 2):rep(2) .. h:sub(3, 3):rep(2) end
    if #h ~= 6 or not h:match("^%x+$") then return nil end
    return Color3.fromRGB(tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16))
end

local function chevron(parent, props)
