function Elements.Chart(parent, ctx, cfg)
    local bars, n = {}, cfg.Points or 40
    local min, max, unit = cfg.Min or 0, cfg.Max or 100, cfg.Unit or ""
    local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, (cfg.Height or 110) + 22), LayoutOrder = nextOrder(parent), Parent = parent })
    local area = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, cfg.Height or 110), Parent = wrap })
    for i = 1, 3 do create("Frame", { BackgroundColor3 = Color3.fromRGB(36, 36, 42), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromScale(0, i / 4), Parent = area }) end
    for i = 1, n do
        bars[i] = create("Frame", { BackgroundColor3 = Library.Theme.Accent, BackgroundTransparency = 0.35, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / n, 1, 1, 0), Size = UDim2.new(1 / n, -2, 0, 0), Parent = area }, { corner(2) })
    end
    local foot = label({ Text = "", TextSize = 11, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -14), Size = UDim2.new(1, 0, 0, 14), Parent = wrap })
    bindTheme(function(t) if wrap.Parent then for _, b in ipairs(bars) do b.BackgroundColor3 = t.Accent end else error("gone") end end)
    local values, obj = {}, { Frame = wrap }
    function obj:Push(v)
        table.insert(values, v)
        if #values > n then table.remove(values, 1) end
        local lo, hi = math.huge, -math.huge
        for i = 1, n do
            local val = values[i - (n - #values)]
            if val then
                lo, hi = math.min(lo, val), math.max(hi, val)
                tween(bars[i], 0.15, { Size = UDim2.new(1 / n, -2, math.clamp((val - min) / (max - min), 0.02, 1), 0) })
                bars[i].BackgroundTransparency = i == n and 0 or 0.35
            end
        end
        foot.Text = string.format("min %d%s  ·  max %d%s", lo, unit, hi, unit)
    end
    register(ctx, cfg.Name, wrap)
    return obj
end

