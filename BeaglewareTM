            local val = label({ Text = "-", Font = FONT_BOLD, TextSize = 22, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 24), Parent = c })
            local sub = label({ Text = "", TextSize = 11, TextColor3 = C.SubText, Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 12), Parent = c })
            cards[name] = { V = val, S = sub }
            register({ Window = Window, Page = tab.Page, Section = "Overview" }, ({ FPS = "FPS", PING = "Ping", PLAYERS = "Players", SESSION = "Session time" })[name], c)
        end
        local fpsChart = tab:Section("FPS", "Left"):AddChart({ Name = "FPS chart", Min = 0, Max = 240, Points = 50 })
        local pingChart = tab:Section("Ping", "Right"):AddChart({ Name = "Ping chart", Min = 0, Max = 300, Unit = "ms", Points = 50 })
        local session = tab:Section("Session", "Left")
        local okName, gameName = pcall(function() return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
        session:Info("Game", okName and gameName or tostring(game.PlaceId))
        session:Info("Executor", (identifyexecutor and select(1, identifyexecutor())) or "Unknown")
        local memRow = session:Info("Memory", "-")
        session:Info("Version", scfg.Version or "v1.0.0")

        local StatsService = game:GetService("Stats")
        local start, frameTimes = os.clock(), {}
        conn(RunService.RenderStepped:Connect(function()
            local now = os.clock()
            table.insert(frameTimes, now)
            while frameTimes[1] and now - frameTimes[1] > 1 do table.remove(frameTimes, 1) end
        end))
        local function getPing()
            local ok, v = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            if ok and v then return math.floor(v + 0.5) end
            return math.floor(LocalPlayer:GetNetworkPing() * 1000 + 0.5)
        end
        task.spawn(function()
            while gui.Parent do
                task.wait(0.2)
                local fps = #frameTimes
                local ping = getPing()
                local secs = math.floor(os.clock() - start)
                fpsChart:Push(fps) pingChart:Push(ping)
                cards.FPS.V.Text = tostring(fps)
                cards.FPS.S.Text, cards.FPS.S.TextColor3 = fps >= 55 and "Smooth" or "Low", fps >= 55 and C.Success or C.Warning
                cards.PING.V.Text = ping .. " ms"
                cards.PING.S.Text, cards.PING.S.TextColor3 = ping <= 100 and "Good" or "High", ping <= 100 and C.Success or C.Warning
                cards.PLAYERS.V.Text = #Players:GetPlayers() .. " / " .. Players.MaxPlayers
                cards.PLAYERS.S.Text = "In this server"
                cards.SESSION.V.Text = string.format("%02d:%02d:%02d", math.floor(secs / 3600), math.floor(secs / 60) % 60, secs % 60)
                cards.SESSION.S.Text = "Since the menu opened"
                memRow:Set(math.floor(StatsService:GetTotalMemoryUsageMb() + 0.5) .. " MB")
            end
        end)
        return tab
    end

    Window.PlayerTags = {}
    function Window:GetTag(player) return (player and self.PlayerTags[player.UserId]) or "Neutral" end
    function Library:GetTag(player) local w = self.Windows[#self.Windows] return w and w:GetTag(player) or "Neutral" end

    function Window:PlayerList(pcfg)
        pcfg = pcfg or {}
        local tab = builtIn(pcfg.Name or "Player List", 2)
        local page = tab.Page
        page.Empty.Visible = false
        local TAG_COLORS = { Neutral = C.Stroke, Whitelist = C.Success, Enemy = C.Error }

        local card = create("Frame", { BackgroundColor3 = C.Card, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = page.TopRow }, { corner(8), stroke(), list(0) })
        local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 1, Parent = card })
        label({ Text = "Players", Font = FONT_MED, TextSize = 15, Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(64, 46), Parent = head })
        local countBadge = create("TextLabel", { Text = "", Font = FONT, TextSize = 11, TextColor3 = C.SubText, BackgroundColor3 = C.Element, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 20), Position = UDim2.new(0, 80, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = head }, { corner(10), pad(0, 8, 0, 8), stroke() })
        local findBox = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.fromOffset(210, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Parent = head }, { corner(6), stroke() })
        local find = create("TextBox", { BackgroundTransparency = 1, Text = "", PlaceholderText = "Find a player...", ClearTextOnFocus = false, Font = FONT, TextSize = 12, TextColor3 = C.Text, PlaceholderColor3 = C.Faint, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Parent = findBox })
        create("Frame", { BackgroundColor3 = C.Stroke, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), LayoutOrder = 2, Parent = card })
        local rowsFrame = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card }, { pad(6), list(2) })
        local noMatch = label({ Text = "No players match that name.", TextSize = 12, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 36), Visible = false, LayoutOrder = 999, Parent = rowsFrame })

        local info = tab:Section("Selected player", "Left")
        local iName, iDist, iTag, iAge = info:Info("Name", "-"), info:Info("Distance", "-"), info:Info("Tag", "-"), info:Info("Account age", "-")

        local rows, selected, spectating, popup = {}, nil, nil, nil
        local function root(plr) local ch = plr and plr.Character return ch and ch:FindFirstChild("HumanoidRootPart") end
        local function distanceTo(plr)
            if plr == LocalPlayer then return "here" end
            local a, b = root(LocalPlayer), root(plr)
            if not (a and b) then return "-" end
            return math.floor((a.Position - b.Position).Magnitude + 0.5) .. " studs"
        end
        local function refreshInfo()
            if not selected or not selected.Parent then iName:Set("-") iDist:Set("-") iTag:Set("-") iAge:Set("-") return end
            iName:Set(selected.DisplayName .. " (@" .. selected.Name .. ")")
            iDist:Set(distanceTo(selected))
            iTag:Set(Window:GetTag(selected))
            iAge:Set(selected.AccountAge .. " days")
        end
        local function setSpectate(plr)
            local cam = workspace.CurrentCamera
            if plr and plr ~= spectating and plr.Character and plr.Character:FindFirstChildOfClass("Humanoid") then
                spectating = plr
                cam.CameraSubject = plr.Character:FindFirstChildOfClass("Humanoid")
            else
                spectating = nil
                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then cam.CameraSubject = hum end
            end
            for _, r in pairs(rows) do r.PaintSpec() end
        end
        Window:OnUnload(function() if spectating then setSpectate(nil) end end)

        local function closePopup() if popup then popup:Destroy() popup = nil end end
        table.insert(Window.Popups, closePopup)
        local function smallButton(parent, text, order, width)
            local b = create("TextButton", { AutoButtonColor = false, Text = text, Font = FONT, TextSize = 12, TextColor3 = C.Text, BackgroundColor3 = C.Element, Size = UDim2.fromOffset(width or 74, 28), LayoutOrder = order, Parent = parent }, { corner(6) })
            local st = stroke() st.Parent = b
            b.MouseEnter:Connect(function() if b:GetAttribute("on") ~= true then tween(b, 0.15, { BackgroundColor3 = C.Hover }) end end)
            b.MouseLeave:Connect(function() if b:GetAttribute("on") ~= true then tween(b, 0.15, { BackgroundColor3 = C.Element }) end end)
            return b, st
        end

        local function addRow(plr)
            if rows[plr] then return end
            local isYou = plr == LocalPlayer
            local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = isYou and 0 or 1, Parent = rowsFrame }, { list(0) })
            local row = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = Color3.fromRGB(29, 29, 34), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 1, Parent = holder }, { corner(6) })
            local tagPanel = collapsible(holder, false, 2)
            local tagRow = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = tagPanel.Inner })
            local tagOpts = create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 4), Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, Parent = tagRow },
                { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
            label({ Text = "Set tag:", TextSize = 12, TextColor3 = C.Muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8 - 3 * 92 - 2 * 6 - 10, 0, 4), Size = UDim2.fromOffset(60, 30), TextXAlignment = Enum.TextXAlignment.Right, Parent = tagRow })

            create("ImageLabel", { BackgroundColor3 = C.Element, Size = UDim2.fromOffset(34, 34), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
                Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=60&h=60", Parent = row }, { corner(17) })
            local nameRow = create("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(52, 7), Size = UDim2.new(1, -330, 0, 17), Parent = row },
                { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
            label({ Text = plr.DisplayName, Font = FONT_MED, TextSize = 14, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 17), LayoutOrder = 1, Parent = nameRow })
            if isYou then
                local you = create("TextLabel", { Text = "YOU", Font = FONT_BOLD, TextSize = 10, TextColor3 = C.Dark, BackgroundColor3 = Library.Theme.Accent, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 15), LayoutOrder = 2, Parent = nameRow }, { corner(8), pad(0, 6, 0, 6) })
                bindTheme(function(t) if you.Parent then you.BackgroundColor3 = t.Accent else error("gone") end end)
            end
            local sub = label({ Text = "@" .. plr.Name, TextSize = 12, TextColor3 = C.Muted, Position = UDim2.fromOffset(52, 26), Size = UDim2.new(1, -330, 0, 15), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })

            local right = create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Parent = row },
                { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })
            local tpBtn = smallButton(right, "Teleport", 1, 72)
            local tagBtn, tagStroke = smallButton(right, "", 2, 104)
            local tagText = label({ Text = Window:GetTag(plr), TextSize = 12, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0), Parent = tagBtn })
            chevron(tagBtn, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(14, 14) })
            local specBtn, specStroke = smallButton(right, "Spectate", 3, 72)
            if isYou then tpBtn.Visible, specBtn.Visible, tagBtn.Visible = false, false, false end

            local r = { Row = holder, Player = plr, Sub = sub }
            local optButtons = {}
            for i, t in ipairs({ "Neutral", "Whitelist", "Enemy" }) do
                local ob = create("TextButton", { AutoButtonColor = false, Text = t, Font = FONT_MED, TextSize = 12, TextColor3 = C.Text, BackgroundColor3 = C.Element, Size = UDim2.fromOffset(92, 30), LayoutOrder = i, Parent = tagOpts }, { corner(6) })
                local os = stroke() os.Parent = ob
                optButtons[t] = { B = ob, S = os }
                ob.MouseButton1Click:Connect(function()
                    Window.PlayerTags[plr.UserId] = t ~= "Neutral" and t or nil
                    r.PaintTag()
                    tagPanel:Set(false)
                    refreshInfo()
                    if pcfg.OnTag then task.spawn(pcfg.OnTag, plr, t) end
                    Library:Notify("Player tag", plr.DisplayName .. " is now " .. t .. ".", t == "Enemy" and "Warning" or t == "Whitelist" and "Success" or "Info")
                end)
            end
            r.OptButtons = optButtons
            function r.PaintTag()
                local t = Window:GetTag(plr)
                tagText.Text = t
                tagStroke.Color = t == "Neutral" and C.Stroke or TAG_COLORS[t]
                for name, o in pairs(r.OptButtons or {}) do
                    local on = name == t
                    o.B.BackgroundColor3 = on and C.Active or C.Element
                    o.S.Color = on and (name == "Neutral" and C.Muted or TAG_COLORS[name]) or C.Stroke
                    o.B.TextColor3 = on and C.Text or C.SubText
                end
            end
            function r.PaintSpec()
                local on = spectating == plr
                specBtn:SetAttribute("on", on)
                specBtn.Text = on and "Stop" or "Spectate"
                tween(specBtn, 0.15, { BackgroundColor3 = on and Library.Theme.Accent or C.Element, TextColor3 = on and C.Dark or C.Text })
                specStroke.Transparency = on and 1 or 0
            end
            function r.PaintSelected() tween(row, 0.15, { BackgroundTransparency = selected == plr and 0 or 1 }) end
            r.PaintTag()

            row.MouseButton1Click:Connect(function()
                selected = plr
                for _, x in pairs(rows) do x.PaintSelected() end
                refreshInfo()
                if pcfg.OnSelect then task.spawn(pcfg.OnSelect, plr) end
            end)
            tpBtn.MouseButton1Click:Connect(function()
                local a, b = root(LocalPlayer), root(plr)
                if a and b then
                    a.CFrame = b.CFrame * CFrame.new(0, 0, 3)
                    Library:Notify("Teleported", "Moved to " .. plr.DisplayName .. ".", "Success")
                else
                    Library:Notify("Teleport", plr.DisplayName .. " has no character right now.", "Warning")
                end
            end)
            tagBtn.MouseButton1Click:Connect(function()
                local open = not tagPanel.Open
                for _, other in pairs(rows) do if other.TagPanel and other ~= r then other.TagPanel:Set(false) end end
                tagPanel:Set(open)
            end)
            r.TagPanel = tagPanel
            specBtn.MouseButton1Click:Connect(function()
                local was = spectating == plr
                if was then setSpectate(nil) else setSpectate(plr) end
                Library:Notify(was and "Stopped spectating" or "Spectating", plr.DisplayName, "Info")
            end)
            rows[plr] = r
            r.PaintSpec()
        end
        local function filter()
            local q = find.Text:lower()
            local n, shown = 0, 0
            for plr, r in pairs(rows) do
                n += 1
                local vis = q == "" or plr.Name:lower():find(q, 1, true) ~= nil or plr.DisplayName:lower():find(q, 1, true) ~= nil
                r.Row.Visible = vis
                if vis then shown += 1 end
            end
            noMatch.Visible = shown == 0
            countBadge.Text = n .. " / " .. Players.MaxPlayers
        end
        for _, plr in ipairs(Players:GetPlayers()) do addRow(plr) end
        filter()
        conn(Players.PlayerAdded:Connect(function(plr) addRow(plr) filter() end))
        conn(Players.PlayerRemoving:Connect(function(plr)
            local r = rows[plr]
            if r then r.Row:Destroy() rows[plr] = nil end
            if spectating == plr then setSpectate(nil) end
            if selected == plr then selected = nil refreshInfo() end
            filter()
        end))
        find:GetPropertyChangedSignal("Text"):Connect(filter)

        task.spawn(function()
            while gui.Parent do
                if Window.Current == page then
                    for plr, r in pairs(rows) do r.Sub.Text = "@" .. plr.Name .. "  ·  " .. distanceTo(plr) end
                    refreshInfo()
                end
                task.wait(0.5)
            end
        end)
        register({ Window = Window, Page = page, Section = "Players" }, "Players", card)
        return tab
    end

    function Window:Settings(scfg)
        scfg = scfg or {}
        local tab = builtIn(scfg.Name or "General", 1)
        tab.Page.NoSave = true
        local themeSec = tab:Section("Theme", "Right")
        for _, row in ipairs({ { "Accent", "Accent" }, { "Streak colour", "Streak" }, { "Streak tip", "StreakTip" }, { "Streak tail", "StreakTail" } }) do
            local key = row[2]
            local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = nextOrder(themeSec.Body), Parent = themeSec.Body })
            label({ Text = row[1], TextSize = 14, Size = UDim2.new(1, -56, 0, 22), Parent = wrap })
            local prevBtn = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = Library.Theme[key], Size = UDim2.fromOffset(42, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = wrap }, { corner(5) })
            local prevStroke = stroke() prevStroke.Parent = prevBtn
            prevBtn.MouseButton1Click:Connect(function()
                local before = Library.Theme[key]
                prevStroke.Color = Library.Theme.Accent
                Window:OpenColorPicker({
                    Title = row[1], Default = before,
                    Changed = function(c) Library:SetTheme(key, c) end,
                    Done = function(c, _, applied) prevStroke.Color = C.Stroke Library:SetTheme(key, applied and c or before) end,
                })
            end)
            local swRow = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 30), Parent = wrap },
                { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
            local strokes = {}
            for i, col in ipairs(PRESETS) do
                local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = col, Size = UDim2.fromOffset(22, 22), LayoutOrder = i, Parent = swRow }, { corner(11) })
                strokes[i] = { S = create("UIStroke", { Thickness = 2, Color = C.Stroke, Parent = b }), C = col }
                b.MouseButton1Click:Connect(function() Library:SetTheme(key, col) end)
            end
            bindTheme(function(t)
                if not wrap.Parent then error("gone") end
                prevBtn.BackgroundColor3 = t[key]
                for _, s in ipairs(strokes) do s.S.Color = (toHex(s.C) == toHex(t[key])) and C.Text or C.Stroke end
            end)
            register({ Window = Window, Page = tab.Page, Section = "Theme" }, row[1], wrap)
        end

        local HttpService = game:GetService("HttpService")
        local folder = "PinkUI/" .. ((cfg.Title or "Hub"):gsub("[^%w%-_ ]", ""))
        local canSave = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
        local function ensureFolder()
            if typeof(makefolder) ~= "function" or typeof(isfolder) ~= "function" then return end
            if not isfolder("PinkUI") then makefolder("PinkUI") end
            if not isfolder(folder) then makefolder(folder) end
        end
        local function listConfigs()
            local out = {}
            if typeof(listfiles) ~= "function" or typeof(isfolder) ~= "function" or not isfolder(folder) then return out end
            for _, f in ipairs(listfiles(folder)) do
                local name = f:match("([^/\\]+)%.json$")
                if name then table.insert(out, name) end
            end
            table.sort(out)
            return out
        end
        local function encodeValue(item)
            local o, k = item.Obj, item.Kind
            if k == "key" then local key = o:Get() return key and key.Name or "None" end
            if k == "color" then local c, a = o:Get() return { Hex = toHex(c), Alpha = a } end
            if k == "text" then return o:Get() end
            return o:Get()
        end
        local function applyValue(item, v)
            local o, k = item.Obj, item.Kind
            if k == "key" then o:Set(v ~= "None" and Enum.KeyCode[v] or nil)
            elseif k == "color" then local c = fromHex(v.Hex) if c then o:Set(c, v.Alpha or 0) end
            elseif k == "dropdown" then o:Set(v)
            elseif k == "bool" then if o:Get() ~= v then o:Set(v) end
            else o:Set(v) end
        end
        local function saveConfig(name)
            if not canSave then Library:Notify("Configs", "Your executor can't save files.", "Error") return false end
            if not name or name:gsub("%s", "") == "" then Library:Notify("Configs", "Type a name for the config first.", "Warning") return false end
            ensureFolder()
            local data = { Elements = {}, Theme = {} }
            for key, item in pairs(Window.Savable) do
                local ok, v = pcall(encodeValue, item)
                if ok then data.Elements[key] = v end
            end
            for k, v in pairs(Library.Theme) do data.Theme[k] = typeof(v) == "Color3" and ("#" .. toHex(v)) or v end
            writefile(folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
            return true
        end
        local function loadConfig(name)
            if not canSave then Library:Notify("Configs", "Your executor can't read files.", "Error") return false end
            local path = folder .. "/" .. tostring(name) .. ".json"
            if not name or not isfile(path) then Library:Notify("Configs", "Pick a saved config first.", "Warning") return false end
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
            if not ok or typeof(data) ~= "table" then Library:Notify("Configs", "That config file is broken.", "Error") return false end
            for k, v in pairs(data.Theme or {}) do
                if typeof(v) == "string" and v:sub(1, 1) == "#" then v = fromHex(v) or Library.Theme[k] end
                Library.Theme[k] = v
            end
            fireTheme()
            for key, v in pairs(data.Elements or {}) do
                local item = Window.Savable[key]
                if item then pcall(applyValue, item, v) end
            end
            return true
        end

        local cfgSec = tab:Section("Configs", "Left")
        local nameBox = cfgSec:AddTextbox({ Name = "Config name", Placeholder = "e.g. farming", NoSave = true })
        local picked
        local listDrop = cfgSec:AddDropdown({ Name = "Saved configs", Options = listConfigs(), NoSave = true, Callback = function(v) picked = v nameBox:Set(v) end })
        local function refresh() listDrop:Refresh(listConfigs()) picked = nil end
        cfgSec:AddButton({ Name = "Save config", Callback = function()
            local name = nameBox:Get()
            if saveConfig(name) then refresh() listDrop:Set(name, true) picked = name Library:Notify("Config saved", name .. " was saved.", "Success") end
        end })
        cfgSec:AddButton({ Name = "Load config", Callback = function()
            if loadConfig(picked) then Library:Notify("Config loaded", picked .. " is now active.", "Success") end
        end })
        cfgSec:AddButton({ Name = "Delete config", Callback = function()
            if not picked then Library:Notify("Configs", "Pick a saved config first.", "Warning") return end
            if typeof(delfile) == "function" then delfile(folder .. "/" .. picked .. ".json") end
            Library:Notify("Config deleted", picked .. " was removed.", "Info")
            refresh()
        end })
        cfgSec:AddButton({ Name = "Refresh list", Callback = refresh })
        local autoPath = folder .. "/autoload.txt"
        cfgSec:AddToggle({ Name = "Load on start", Description = "Loads the selected config next time", NoSave = true,
            Default = canSave and isfile(autoPath) or false,
            Callback = function(on)
                if not canSave then return end
                ensureFolder()
                if on then
                    if not picked then Library:Notify("Configs", "Pick a saved config first.", "Warning") return end
                    writefile(autoPath, picked)
                elseif isfile(autoPath) and typeof(delfile) == "function" then delfile(autoPath) end
            end })
        for i = #Window.Switches, 1, -1 do if Window.Switches[i].Frame and Window.Switches[i].Frame:IsDescendantOf(tab.Page.Group) then table.remove(Window.Switches, i) end end

        task.delay(1, function()
            if canSave and isfile(autoPath) then
                local name = readfile(autoPath)
                if loadConfig(name) then
                    picked = name
                    listDrop:Set(name, true)
                    Library:Notify("Config loaded", name .. " was loaded automatically.", "Info")
                end
            end
        end)
        Window.SaveConfig, Window.LoadConfig = function(_, n) return saveConfig(n) end, function(_, n) return loadConfig(n) end

        local menu = tab:Section("Menu", "Left")
        menu:AddKeybind({ Name = "Show / hide menu", Default = Window.ToggleKey, Changed = function(k)
            Window.ToggleKey = k
            if k then Library:Notify("Menu key", "Press " .. keyName(k) .. " to show or hide the menu.", "Info")
            else Library:Notify("Menu key", "No key set. Click the box to pick one.", "Warning") end
        end })

        local border = tab:Section("Border line", "Right")
        local linesT = border:AddToggle({ Name = "Gradient lines", Description = "Streaks travelling around the edge", Default = Library.Theme.Lines, Callback = function(v) Library:SetTheme("Lines", v) end })
        local lapS = border:AddSlider({ Name = "Lap time", Min = 3, Max = 16, Default = Library.Theme.LapTime, Suffix = "s", Callback = function(v) Library:SetTheme("LapTime", v) end })

        for i = #Window.Switches, 1, -1 do if Window.Switches[i] == linesT then table.remove(Window.Switches, i) end end

        local bg = tab:Section("Background", "Right")
        local modeD = bg:AddDropdown({ Name = "Dot mode", Options = { "Twinkle", "Follow cursor", "Wave", "Scattered wave", "Off" }, Default = Library.Theme.DotMode, Callback = function(v) Library:SetTheme("DotMode", v) end })

        local reset = tab:Section("Reset", "Right")
        reset:AddParagraph({ Title = "Default theme", Content = "Go back to the default pink theme." })
        reset:AddButton({ Name = "Reset to default", Callback = function()
            Library:ResetTheme()
            linesT:Set(DEFAULT_THEME.Lines, true)
            lapS:Set(DEFAULT_THEME.LapTime, true)
            modeD:Set(DEFAULT_THEME.DotMode, true)
        end })
        return tab
    end
    Window.AddStatsTab, Window.AddSettingsTab = Window.Stats, Window.Settings

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Window(title, toggleKey)
    if typeof(title) == "table" then return self:CreateWindow(title) end
    return self:CreateWindow({ Title = title, ToggleKey = toggleKey })
end

return Library
