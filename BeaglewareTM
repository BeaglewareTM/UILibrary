    local dotLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = content })
    local dots, GAP = {}, 18
    local CW, CH, cols = W - SIDE - 1, H - TOP - 1, 1
    local function buildDots()
        for _, d in ipairs(dots) do d.F:Destroy() end
        table.clear(dots)
        CW, CH = math.max(content.AbsoluteSize.X, 1), math.max(content.AbsoluteSize.Y, 1)
        if CW < 2 then CW, CH = main.Size.X.Offset - SIDE - 1, main.Size.Y.Offset - TOP - 1 end
        cols = math.floor(CW / GAP)
        local rowsN = math.floor(CH / GAP)
        local rng = Random.new(42)
        local offX, offY = math.floor((CW - cols * GAP) / 2), math.floor((CH - rowsN * GAP) / 2)
        for cy = 0, rowsN - 1 do
            for cx = 0, cols - 1 do
                local x, y = offX + cx * GAP + GAP / 2, offY + cy * GAP + GAP / 2
                local f = Instance.new("Frame")
                f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = Library.Theme.Accent, 1, 0
                f.AnchorPoint, f.Position, f.Size, f.ZIndex = Vector2.new(0.5, 0.5), UDim2.fromOffset(x, y), UDim2.fromOffset(2, 2), 1
                local cr = Instance.new("UICorner") cr.CornerRadius = UDim.new(0, 2) cr.Parent = f
                f.Parent = dotLayer
                table.insert(dots, { F = f, X = x, Y = y, Cx = cx, A = -1, Scatter = rng:NextNumber() < 0.22, Delay = rng:NextNumber() * 1.4 })
            end
        end
    end
    buildDots()
    local function dotBase()
        local w = C.Window
        local lum = 0.299 * w.R + 0.587 * w.G + 0.114 * w.B
        return lum > 0.5 and Library.Theme.Accent:Lerp(Color3.new(0, 0, 0), 0.35) or Library.Theme.Accent
    end
    local function setDot(d, a)
        if math.abs(a - d.A) < 0.03 then return end
        d.A = a
        local base = dotBase()
        d.F.BackgroundTransparency = 0.86 - 0.86 * a
        d.F.Size = UDim2.fromOffset(2 + 2 * a, 2 + 2 * a)
        d.F.BackgroundColor3 = base:Lerp(Library.Theme.StreakTip, a)
    end
    bindTheme(function()
        if not main.Parent then error("gone") end
        for _, d in ipairs(dots) do d.A = -1 setDot(d, 0) end
    end)
    local twinkles, lastMode, clock = {}, nil, 0
    conn(RunService.RenderStepped:Connect(function(dt)
        if not main.Visible then return end
        clock += dt
        local mode = Library.Theme.DotMode
        dotLayer.Visible = mode ~= "Off"
        if mode ~= lastMode then
            for _, d in ipairs(dots) do setDot(d, 0) end
            table.clear(twinkles)
            lastMode = mode
        end
        if mode == "Twinkle" then
            while #twinkles < 40 do table.insert(twinkles, { D = dots[math.random(#dots)], T = -math.random() * 6, Dur = 3 + math.random() * 4 }) end
            for i = #twinkles, 1, -1 do
                local tw = twinkles[i]
                tw.T += dt
                if tw.T >= tw.Dur then setDot(tw.D, 0) table.remove(twinkles, i)
                elseif tw.T > 0 then setDot(tw.D, math.sin(math.pi * tw.T / tw.Dur) ^ 2) end
            end
        elseif mode == "Follow cursor" then
            local m = UserInputService:GetMouseLocation()
            local rel = Vector2.new(m.X, m.Y) - content.AbsolutePosition
            for _, d in ipairs(dots) do
                local dist = (Vector2.new(d.X, d.Y) - rel).Magnitude
                setDot(d, dist < 110 and (1 - dist / 110) or 0)
            end
        elseif mode == "Wave" then
            local band = CW * 0.35
            local x = ((clock % 4.5) / 4.5) * (CW + band * 2) - band
            for _, d in ipairs(dots) do setDot(d, math.max(0, 1 - math.abs(d.X - x) / (band / 2))) end
        elseif mode == "Scattered wave" then
            for _, d in ipairs(dots) do
                if d.Scatter then
                    local p = ((clock + d.Delay + (1 - d.Cx / math.max(cols, 1)) * 4) % 5) / 5
                    local a = 0
                    if p < 0.06 then a = p / 0.06 elseif p < 0.18 then a = 1 - (p - 0.06) / 0.12 end
                    setDot(d, a)
                end
            end
        end
    end))

