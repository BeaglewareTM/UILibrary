local function shapeColor(h, color) for _, c in ipairs(h:GetChildren()) do if c:IsA("Frame") then c.BackgroundColor3 = color end end end
local function shapeVisible(h, v) for _, c in ipairs(h:GetChildren()) do if c:IsA("Frame") then c.BackgroundTransparency = v and 0 or 1 end end end

local function collapsible(parent, open, order)
    local clip = create("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = order or 0, Parent = parent })
    local inner = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = clip })
    local self = { Clip = clip, Inner = inner, Open = open }
    local busy = false
    local function target() return self.Open and inner.AbsoluteSize.Y or 0 end
    function self:Set(v, instant)
        self.Open = v
        if instant then clip.Size = UDim2.new(1, 0, 0, target()) return end
        busy = true
        local tw = tween(clip, 0.32, { Size = UDim2.new(1, 0, 0, target()) })
        tw.Completed:Connect(function() busy = false clip.Size = UDim2.new(1, 0, 0, target()) end)
    end
    inner:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if self.Open and not busy then clip.Size = UDim2.new(1, 0, 0, inner.AbsoluteSize.Y) end
    end)
    task.defer(function() self:Set(open, true) end)
    return self
end

local function getParentGui()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    local okCore, core = pcall(function() return game:GetService("CoreGui") end)
    if okCore and core and pcall(function() local f = Instance.new("Folder") f.Parent = core f:Destroy() end) then return core end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local NOTIFY_TYPES = {
    Success = { Color = C.Success, Icon = "check" },
    Info    = { Color = nil,       Icon = "i" },
    Warning = { Color = C.Warning, Icon = "!" },
    Error   = { Color = C.Error,   Icon = "x" },
}
local notifyHolder

function Library:Notify(cfg, content, ntype, dur)
    if typeof(cfg) ~= "table" then cfg = { Title = cfg, Content = content, Type = ntype, Duration = dur } end
    if not notifyHolder then warn("[PinkUI] Make a window before sending notifications") return end
    local kind = NOTIFY_TYPES[cfg.Type or "Info"] or NOTIFY_TYPES.Info
    local color = kind.Color or self.Theme.Accent
    local duration = cfg.Duration or 4

    local alive = {}
    for _, c in ipairs(notifyHolder:GetChildren()) do
        if c:IsA("Frame") and not c:GetAttribute("_closing") then table.insert(alive, c) end
    end
    table.sort(alive, function(a, b) return a.LayoutOrder < b.LayoutOrder end)

    local slot = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = nextOrder(notifyHolder), Parent = notifyHolder })
    local card = create("Frame", { BackgroundColor3 = C.Card, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(320, 0), ClipsDescendants = true, Parent = slot }, { corner(10), stroke(Color3.fromRGB(38, 38, 44)) })
    local box = create("Frame", { BackgroundColor3 = color, BackgroundTransparency = 0.88, Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 12, 0.5, -1), AnchorPoint = Vector2.new(0, 0.5), Parent = card }, { corner(8), stroke(color, 1, 0.7) })
    if kind.Icon == "check" then drawCheck(box, color, 14)
    elseif kind.Icon == "x" then drawX(box, color, 10)
    else label({ Text = kind.Icon, Font = FONT_BOLD, TextSize = 16, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = box }) end
    label({ Text = cfg.Title or "Notification", Font = FONT_BOLD, TextSize = 14, Position = UDim2.fromOffset(54, 11), Size = UDim2.new(1, -100, 0, 17), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
    label({ Text = "now", TextSize = 11, TextColor3 = C.Faint, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(1, -44, 0, 12), Size = UDim2.fromOffset(32, 14), Parent = card })
    label({ Text = cfg.Content or "", TextSize = 12, TextColor3 = Color3.fromRGB(163, 163, 173), Position = UDim2.fromOffset(54, 30), Size = UDim2.new(1, -66, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd, Parent = card })
    local barBack = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.96, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), Parent = card })
    local bar = create("Frame", { BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = barBack })

    tween(card, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
    local function close()
        if slot:GetAttribute("_closing") then return end
        slot:SetAttribute("_closing", true)
        tween(card, 0.3, { Position = UDim2.fromOffset(320, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.wait(0.22)
        tween(slot, 0.25, { Size = UDim2.new(1, 0, 0, 0) })
        task.wait(0.27)
        slot:Destroy()
    end
    slot:GetAttributeChangedSignal("_force"):Connect(function() task.spawn(close) end)
    if #alive >= 4 then alive[1]:SetAttribute("_force", true) end
    task.spawn(function()
        tween(bar, duration, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)
        task.wait(duration)
        close()
    end)
end

local function fireNotify(n, value, on)
    if not n then return end
    local spec = n
    if on ~= nil and (n.On or n.Off) then
        spec = on and n.On or n.Off
        if not spec then return end
    end
    local content = (spec.Content or n.Content or ""):gsub("{value}", tostring(value))
    Library:Notify({ Title = spec.Title or n.Title or "Notification", Content = content, Type = spec.Type or n.Type or "Info", Duration = spec.Duration or n.Duration })
end

local keyListeners, listening = {}, nil
local function keyName(code)
    if code == nil then return "None" end
    return (code.Name:gsub("Control", "Ctrl"):gsub("Left", "L"):gsub("Right", "R"))
end
UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if listening then
        local b = listening
        listening = nil
        if input.KeyCode == Enum.KeyCode.Escape then b:_finish(nil) else b:_finish(input.KeyCode) end
        return
    end
    if gp then return end
    for _, l in ipairs(keyListeners) do
        if l.Key() == input.KeyCode then task.spawn(l.Fn) end
    end
end)

local function keyBadge(parent, default, onChanged)
    local key = default
    local badge = create("TextButton", {
        AutoButtonColor = false, Text = keyName(key), Font = FONT_MED, TextSize = 12, TextColor3 = C.Text, BackgroundColor3 = C.Element,
        AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(46, 28), Parent = parent,
    }, { corner(5), pad(0, 10, 0, 10), create("UISizeConstraint", { MinSize = Vector2.new(46, 28) }) })
    local s = stroke() s.Parent = badge
    local obj = { Frame = badge }
    function obj:_finish(code)
        key = code
        badge.Text = keyName(key)
        tween(s, 0.2, { Color = C.Stroke })
        if onChanged then onChanged(key) end
    end
    function obj:Get() return key end
    function obj:Set(code) key = code badge.Text = keyName(key) end
    badge.MouseButton1Click:Connect(function()
        if listening == obj then listening = nil obj:_finish(key) return end
        listening = obj
        badge.Text = "..."
        tween(s, 0.2, { Color = Library.Theme.Accent })
    end)
    return obj
end

local function savable(ctx, cfg, obj, kind)
    if not ctx or not ctx.Window or ctx.Page.NoSave or cfg.NoSave then return end
    local page = ctx.Page
    local key = cfg.Flag or ((page.Parent and (page.Parent.Name .. "/") or "") .. page.Name .. "/" .. (ctx.Section or "") .. "/" .. (cfg.Name or "?"))
    ctx.Window.Savable[key] = { Obj = obj, Kind = kind }
end

local function register(ctx, name, frame)
    if not ctx or not ctx.Window then return end
    table.insert(ctx.Window.Index, { Name = name or "", Frame = frame, Page = ctx.Page, Section = ctx.Section })
end

local function titleBlock(parent, name, desc, rightPad)
    local block = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -(rightPad or 0), 0, desc and 34 or 18), Parent = parent })
    label({ Text = name, TextSize = 14, Size = UDim2.new(1, 0, 0, 17), TextTruncate = Enum.TextTruncate.AtEnd, Parent = block })
    if desc then
        label({ Text = desc, TextSize = 12, TextColor3 = C.SubText, Position = UDim2.fromOffset(0, 19), Size = UDim2.new(1, 0, 0, 15), TextTruncate = Enum.TextTruncate.AtEnd, Parent = block })
    end
    return block
end

local function makeSwitch(parent)
    local track = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.fromOffset(44, 24), Parent = parent }, { corner(12) })
    local s = stroke() s.Parent = track
    local knob = create("Frame", { BackgroundColor3 = C.Muted, Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = track }, { corner(8) })
    local sw = { Frame = track, On = false, Pressed = false }
    function sw:Layout(instant)
        local w = self.Pressed and 22 or 16
        local x = self.On and (44 - w - 4) or 4
        local accent = Library.Theme.Accent
        if instant then
            knob.Size, knob.Position = UDim2.fromOffset(w, 16), UDim2.new(0, x, 0.5, 0)
            knob.BackgroundColor3 = self.On and Color3.new(1, 1, 1) or C.Muted
            track.BackgroundColor3 = self.On and accent or C.Element
            s.Color = self.On and accent or C.Stroke
        else
            tween(knob, 0.38, { Size = UDim2.fromOffset(w, 16), Position = UDim2.new(0, x, 0.5, 0) }, Enum.EasingStyle.Back)
            tween(knob, 0.25, { BackgroundColor3 = self.On and Color3.new(1, 1, 1) or C.Muted })
            tween(track, 0.25, { BackgroundColor3 = self.On and accent or C.Element })
            tween(s, 0.25, { Color = self.On and accent or C.Stroke })
        end
    end
    bindTheme(function() if track.Parent then sw:Layout(true) else error("gone") end end)
    return sw
end
local function hookPress(button, sw)
    button.MouseButton1Down:Connect(function() sw.Pressed = true sw:Layout() end)
    local function release() if sw.Pressed then sw.Pressed = false sw:Layout() end end
    button.MouseButton1Up:Connect(release)
    button.MouseLeave:Connect(release)
end

local function ripple(button)
    local m = UserInputService:GetMouseLocation()
    local rel = Vector2.new(m.X, m.Y) - button.AbsolutePosition
    local size = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 2.4
    local circle = create("Frame", {
        BackgroundColor3 = Library.Theme.Accent, BackgroundTransparency = 0.5, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(rel.X, rel.Y), Size = UDim2.fromOffset(0, 0), ZIndex = button.ZIndex, Parent = button,
    }, { corner(999) })
    tween(circle, 0.6, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 })
    task.delay(0.62, function() circle:Destroy() end)
end
local function styledButton(parent, text, order, height)
    local btn = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Element, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, height or 32), LayoutOrder = order or 0, Parent = parent }, { corner(5), stroke() })
    local scale = create("UIScale", { Parent = btn })
    local txt = label({ Text = text, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = btn.ZIndex + 1, Parent = btn })
    btn.MouseEnter:Connect(function() tween(btn, 0.2, { BackgroundColor3 = C.Hover }) end)
    btn.MouseLeave:Connect(function() tween(btn, 0.2, { BackgroundColor3 = C.Element }) tween(scale, 0.15, { Scale = 1 }) end)
    btn.MouseButton1Down:Connect(function() tween(scale, 0.12, { Scale = 0.96 }) end)
    btn.MouseButton1Up:Connect(function() tween(scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end)
    btn.MouseButton1Click:Connect(function() ripple(btn) end)
    return btn, txt
end

