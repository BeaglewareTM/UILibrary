                if pcfg.OnSelect then task.spawn(pcfg.OnSelect, plr) end
            end)
            tpBtn.MouseButton1Click:Connect(function()
                local a, b = root(LocalPlayer), root(plr)
                if a and b then
                    a.CFrame = b.CFrame * CFrame.new(0, 0, 3)
