function Elements.Checkbox(parent, ctx, cfg)
    local state = cfg.Default or false
    local row = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = nextOrder(parent), Parent = parent })
    local box = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = row }, { corner(5) })
    local s = stroke() s.Parent = box
    local mark = drawCheck(box, C.Dark, 13)
    local scale = create("UIScale", { Parent = mark })
    label({ Text = cfg.Name or "Checkbox", TextSize = 14, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -30, 1, 0), Parent = row })
    local obj = { Frame = row }
    local function draw(instant)
        local accent, t = Library.Theme.Accent, instant and 0 or 0.2
        tween(box, t, { BackgroundColor3 = state and accent or C.Element, BackgroundTransparency = state and 0 or Alpha.Element })
        tween(s, t, { Color = state and accent or C.Stroke })
        shapeVisible(mark, state)
        tween(scale, instant and 0 or 0.3, { Scale = state and 1 or 0.4 }, Enum.EasingStyle.Back)
    end
    function obj:Set(v, silent)
        state = v draw()
        if not silent then
            if cfg.Callback then task.spawn(cfg.Callback, v) end
            fireNotify(cfg.Notify, v and "on" or "off", v)
        end
    end
    function obj:Get() return state end
    bindTheme(function() if row.Parent then draw(true) else error("gone") end end)
    row.MouseButton1Click:Connect(function() obj:Set(not state) end)
    register(ctx, cfg.Name, row)
    if ctx and ctx.Window then table.insert(ctx.Window.Switches, obj) end
    if cfg.Flag then Library.Flags[cfg.Flag] = obj end
    savable(ctx, cfg, obj, "bool")
    return obj
end

function Elements.Slider(parent, ctx, cfg)
    local min, max, inc = cfg.Min or 0, cfg.Max or 100, cfg.Increment or 1
    local value = math.clamp(cfg.Default or min, min, max)
    local suffix = cfg.Suffix or ""
    local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, (cfg.Description and 34 or 18) + 20), LayoutOrder = nextOrder(parent), Parent = parent })
    titleBlock(wrap, cfg.Name or "Slider", cfg.Description, 64)
    local valueLbl = label({ Text = "", TextSize = 14, TextColor3 = C.SubText, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(64, 17), Parent = wrap })
    local hit = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.new(0, 0, 1, -16), Parent = wrap })
    local bar = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromScale(0, 0.5), AnchorPoint = Vector2.new(0, 0.5), Parent = hit }, { corner(3), stroke() })
    local fill = create("Frame", { BackgroundColor3 = Library.Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = bar }, { corner(3) })
    local knob = create("Frame", { BackgroundColor3 = Library.Theme.Accent, Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Parent = bar }, { corner(7) })
    local kscale = create("UIScale", { Parent = knob })
    bindTheme(function(t) if wrap.Parent then fill.BackgroundColor3 = t.Accent knob.BackgroundColor3 = t.Accent else error("gone") end end)

    local obj = { Frame = wrap }
    local decimals = tostring(inc):match("%.(%d+)")
    local function fmt(v) return (decimals and string.format("%." .. #decimals .. "f", v) or tostring(math.floor(v + 0.5))) .. suffix end
    local function draw(instant)
        local a = (value - min) / math.max(max - min, 1e-9)
        valueLbl.Text = fmt(value)
        tween(fill, instant and 0 or 0.08, { Size = UDim2.fromScale(a, 1) })
        tween(knob, instant and 0 or 0.08, { Position = UDim2.fromScale(a, 0.5) })
    end
    function obj:Set(v, silent)
        v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
        if v == value then draw() return end
        value = v draw()
        if not silent and cfg.Callback then task.spawn(cfg.Callback, v) end
    end
    function obj:Get() return value end
    local dragging = false
    local function update(x) obj:Set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            tween(kscale, 0.2, { Scale = 1.25 }, Enum.EasingStyle.Back)
            update(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tween(kscale, 0.2, { Scale = 1 })
            fireNotify(cfg.Notify, fmt(value))
        end
    end)
    draw(true)
    register(ctx, cfg.Name, wrap)
    if cfg.Flag then Library.Flags[cfg.Flag] = obj end
    savable(ctx, cfg, obj, "number")
    return obj
end

function Elements.Dropdown(parent, ctx, cfg)
    local options, multi = cfg.Options or {}, cfg.Multi or false
    local selected
    if multi then
        selected = {}
        for _, v in ipairs(typeof(cfg.Default) == "table" and cfg.Default or {}) do selected[v] = true end
    else
        selected = cfg.Default
    end
    local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(parent), Parent = parent }, { list(6) })
    if cfg.Name and not cfg.HideName then label({ Text = cfg.Name, TextSize = 14, Size = UDim2.new(1, 0, 0, 17), LayoutOrder = 1, Parent = wrap }) end

    local shell = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = wrap }, { corner(5), stroke(), list(0) })
    local box = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Hover, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 1, Parent = shell }, { corner(5) })
    local shown = label({ Text = "", TextSize = 14, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -44, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = box })
    local arrow = chevron(box, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0) })
    box.MouseEnter:Connect(function() tween(box, 0.2, { BackgroundTransparency = 0 }) end)
    box.MouseLeave:Connect(function() tween(box, 0.2, { BackgroundTransparency = 1 }) end)
    local panel = collapsible(shell, false, 2)
    create("Frame", { BackgroundColor3 = C.Stroke, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Parent = panel.Inner })
    local MAX_LIST = 5 * 28 + 4 * 2 + 8
    local listFrame = create("ScrollingFrame", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 1), Size = UDim2.new(1, 0, 0, 8), CanvasSize = UDim2.new(),
        ScrollBarThickness = 3, ScrollBarImageColor3 = C.Stroke, ScrollingDirection = Enum.ScrollingDirection.Y, VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        ElasticBehavior = Enum.ElasticBehavior.Never, Parent = panel.Inner,
    }, { pad(4) })
    local listLayout = list(2)
    listLayout.Parent = listFrame
    local function fitList()
        local h = listLayout.AbsoluteContentSize.Y + 8
        listFrame.CanvasSize = UDim2.fromOffset(0, h)
        listFrame.Size = UDim2.new(1, 0, 0, math.min(h, MAX_LIST))
        listFrame.ScrollBarThickness = h > MAX_LIST and 3 or 0
    end
    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fitList)
    task.defer(fitList)

    local obj = { Frame = wrap }
    local function count() local n = 0 for _ in pairs(selected) do n += 1 end return n end
    local function current()
        if not multi then return selected end
        local out = {}
        for _, o in ipairs(options) do if selected[o] then table.insert(out, o) end end
        return out
    end
    local function refreshText()
        if multi then
            local n = count()
            shown.Text = (n == 0 and "None") or (n == #options and "All selected") or table.concat(current(), ", ")
        else
            shown.Text = selected ~= nil and tostring(selected) or "Select..."
        end
    end
    local function fire()
        local v = current()
        if cfg.Callback then task.spawn(cfg.Callback, v) end
    end
    local function tickBox(rowBtn, on)
        local b = create("Frame", { BackgroundColor3 = on and Library.Theme.Accent or C.Element, BackgroundTransparency = on and 0 or Alpha.Element, Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 8, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = rowBtn }, { corner(4), stroke() })
        local m = drawCheck(b, C.Dark, 11)
        shapeVisible(m, on)
        local dash = create("Frame", { BackgroundColor3 = C.Dark, BorderSizePixel = 0, Visible = false, Size = UDim2.fromOffset(8, 2), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = b })
        return b, m, dash
    end

    local rows = {}
    local build
    build = function()
        for _, r in ipairs(rows) do r:Destroy() end
        table.clear(rows)
        local order = 0
        local function mk(text, bold)
            order += 1
            local r = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Active, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = listFrame }, { corner(4) })
            local l = label({ Text = text, TextSize = 13, Font = bold and FONT_BOLD or FONT, TextColor3 = C.SubText, Position = UDim2.fromOffset(multi and 32 or 10, 0), Size = UDim2.new(1, -42, 1, 0), Parent = r })
            r.MouseEnter:Connect(function() tween(r, 0.15, { BackgroundTransparency = 0.5 }) end)
            r.MouseLeave:Connect(function() tween(r, 0.15, { BackgroundTransparency = (not multi and selected == text) and 0 or 1 }) end)
            table.insert(rows, r)
            return r, l
        end
        if multi and cfg.SelectAll ~= false and #options > 0 then
            local r, l = mk("", true)
            l.TextColor3 = C.Text
            local n = count()
            local full, some = n == #options, n > 0 and n < #options
            l.Text = full and "Deselect all" or "Select all"
            local _, m, dash = tickBox(r, full or some)
            shapeVisible(m, full)
            dash.Visible = some
            r.MouseButton1Click:Connect(function()
                table.clear(selected)
                if not full then for _, o in ipairs(options) do selected[o] = true end end
                build() refreshText() fire()
                fireNotify(cfg.Notify, full and "None" or "All")
            end)
            order += 1
            table.insert(rows, create("Frame", { BackgroundColor3 = C.Stroke, BorderSizePixel = 0, Size = UDim2.new(1, -8, 0, 1), LayoutOrder = order, Parent = listFrame }))
        end
        for _, o in ipairs(options) do
            local r, l = mk(tostring(o))
            local on = (multi and selected[o]) or (not multi and selected == o) or false
            l.TextColor3 = on and C.Text or C.SubText
            if not multi and on then r.BackgroundTransparency = 0 end
            if multi then tickBox(r, on) end
            r.MouseButton1Click:Connect(function()
                if multi then
                    selected[o] = (not selected[o]) or nil
                    build() refreshText() fire()
                    fireNotify(cfg.Notify, tostring(o) .. (selected[o] and " added" or " removed"), selected[o] == true)
                else
                    selected = o
                    build() refreshText()
                    obj:Toggle(false)
                    fire()
                    fireNotify(cfg.Notify, tostring(o))
                end
            end)
        end
    end
    function obj:Toggle(v)
        if v == nil then v = not panel.Open end
        panel:Set(v)
        tween(arrow, 0.25, { Rotation = v and 180 or 0 })
    end
    function obj:Set(v, silent)
        if multi then
            table.clear(selected)
            for _, o in ipairs(v or {}) do selected[o] = true end
        else
            selected = v
        end
        build() refreshText()
        if not silent then fire() end
    end
    function obj:Get() return current() end
    function obj:Refresh(newOptions, keep)
        options = newOptions or {}
        if not keep then if multi then table.clear(selected) else selected = nil end end
        build() refreshText()
    end
    box.MouseButton1Click:Connect(function() obj:Toggle() end)
    bindTheme(function() if wrap.Parent then build() else error("gone") end end)
    refreshText()
