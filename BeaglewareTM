function Elements.Checkbox(parent, ctx, cfg)
    local state = cfg.Default or false
    local row = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = nextOrder(parent), Parent = parent })
    local box = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, 0, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Parent = row }, { corner(5) })
    local s = stroke() s.Parent = box
    local mark = drawCheck(box, C.Dark, 13)
    local scale = create("UIScale", { Parent = mark })
    label({ Text = cfg.Name or "Checkbox", TextSize = 14, Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -30, 1, 0), Parent = row })
    local obj = { Frame = row }
    local function draw(instant)
        local accent, t = Library.Theme.Accent, instant and 0 or 0.2
        tween(box, t, { BackgroundColor3 = state and accent or C.Element })
        tween(s, t, { Color = state and accent or C.Stroke })
        shapeVisible(mark, state)
        tween(scale, instant and 0 or 0.3, { Scale = state and 1 or 0.4 }, Enum.EasingStyle.Back)
    end
    function obj:Set(v, silent)
        state = v draw()
        if not silent then
            if cfg.Callback then task.spawn(cfg.Callback, v) end
            fireNotify(cfg.Notify, v and "on" or "off", v)
        end
    end
    function obj:Get() return state end
    bindTheme(function() if row.Parent then draw(true) else error("gone") end end)
    row.MouseButton1Click:Connect(function() obj:Set(not state) end)
    register(ctx, cfg.Name, row)
    if ctx and ctx.Window then table.insert(ctx.Window.Switches, obj) end
    if cfg.Flag then Library.Flags[cfg.Flag] = obj end
    savable(ctx, cfg, obj, "bool")
    return obj
end

function Elements.Slider(parent, ctx, cfg)
