    local HttpService = game:GetService("HttpService")
    local ROOT = "BeaglewareUI"
    local hubFolder = ROOT .. "/" .. (tostring(cfg.Title or "Hub"):gsub("[^%w%-_ ]", ""))
    local themeFolder = ROOT .. "/Themes"
    local canSave = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
    local function ensure(path)
        if typeof(makefolder) ~= "function" or typeof(isfolder) ~= "function" then return end
        local acc = ""
        for part in path:gmatch("[^/]+") do
            acc = acc == "" and part or (acc .. "/" .. part)
            if not isfolder(acc) then pcall(makefolder, acc) end
        end
    end
    local function listJson(folder)
        local out = {}
        if typeof(listfiles) ~= "function" or typeof(isfolder) ~= "function" or not isfolder(folder) then return out end
        for _, f in ipairs(listfiles(folder)) do
            local name = f:match("([^/\\]+)%.json$")
            if name then table.insert(out, name) end
        end
        table.sort(out)
        return out
    end
    local settingsPath = hubFolder .. "/settings.json"
    local stored = {}
    if canSave then
        pcall(function() if isfile(settingsPath) then stored = HttpService:JSONDecode(readfile(settingsPath)) end end)
        if typeof(stored) ~= "table" then stored = {} end
    end
    local function storeSetting(k, v)
        stored[k] = v
        if not canSave then return end
        ensure(hubFolder)
        pcall(writefile, settingsPath, HttpService:JSONEncode(stored))
    end
    if stored.MobileButton then Window:SetMobileButton(stored.MobileButton) end
    if stored.Reload ~= nil then Window.ReloadOnTeleport = stored.Reload == true end

    function Window:Settings(scfg)
        scfg = scfg or {}
        local tab = builtIn(scfg.Name or "General", 1)
        tab.Page.NoSave = true

        local function encodeValue(item)
            local o, k = item.Obj, item.Kind
            if k == "key" then local key = o:Get() return key and key.Name or "None" end
            if k == "color" then local c, a = o:Get() return { Hex = toHex(c), Alpha = a } end
            return o:Get()
        end
        local function applyValue(item, v)
            local o, k = item.Obj, item.Kind
            if k == "key" then o:Set(v ~= "None" and Enum.KeyCode[v] or nil)
            elseif k == "color" then local c = fromHex(v.Hex) if c then o:Set(c, v.Alpha or 0) end
            elseif k == "dropdown" then o:Set(v)
            elseif k == "bool" then if o:Get() ~= v then o:Set(v) end
            else o:Set(v) end
        end
        local function saveConfig(name)
            if not canSave then Library:Notify("Configs", "Your executor can't save files.", "Error") return false end
            if not name or name:gsub("%s", "") == "" then Library:Notify("Configs", "Type a name for the config first.", "Warning") return false end
            ensure(hubFolder)
            local data = { Elements = {}, Theme = {}, Appearance = { Mode = Library.Appearance.Mode, Custom = Library.Appearance.Custom } }
            for key, item in pairs(Window.Savable) do
                local ok, v = pcall(encodeValue, item)
                if ok then data.Elements[key] = v end
            end
            for k, v in pairs(Library.Theme) do data.Theme[k] = typeof(v) == "Color3" and ("#" .. toHex(v)) or v end
            writefile(hubFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
            return true
        end
        local afterLoad = {}
        local function loadConfig(name)
            if not canSave then Library:Notify("Configs", "Your executor can't read files.", "Error") return false end
            local path = hubFolder .. "/" .. tostring(name) .. ".json"
            if not name or not isfile(path) then Library:Notify("Configs", "Pick a saved config first.", "Warning") return false end
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
            if not ok or typeof(data) ~= "table" then Library:Notify("Configs", "That config file is broken.", "Error") return false end
            for k, v in pairs(data.Theme or {}) do
                if typeof(v) == "string" and v:sub(1, 1) == "#" then v = fromHex(v) or Library.Theme[k] end
                Library.Theme[k] = v
            end
            if typeof(data.Appearance) == "table" then
                local cu = table.clone(CUSTOM_DEFAULT)
                for k, v in pairs(typeof(data.Appearance.Custom) == "table" and data.Appearance.Custom or {}) do cu[k] = v end
                Library.Appearance.Custom = cu
                Library.Appearance.Mode = table.find(MODE_LIST, data.Appearance.Mode) and data.Appearance.Mode or "Dark"
                applyPalette()
            end
            fireTheme()
            for key, v in pairs(data.Elements or {}) do
                local item = Window.Savable[key]
                if item then pcall(applyValue, item, v) end
            end
            for _, fn in ipairs(afterLoad) do pcall(fn) end
            return true
        end

        local cfgSec = tab:Section("Configs", "Left")
        local nameBox = cfgSec:AddTextbox({ Name = "Config name", Placeholder = "e.g. farming", NoSave = true })
        local picked
        local listDrop = cfgSec:AddDropdown({ Name = "Saved configs", Options = listJson(hubFolder), NoSave = true, Callback = function(v) picked = v nameBox:Set(v) end })
        local function listConfigs()
            local out = {}
            for _, n in ipairs(listJson(hubFolder)) do if n ~= "settings" then table.insert(out, n) end end
            return out
        end
        listDrop:Refresh(listConfigs())
        local function refresh() listDrop:Refresh(listConfigs()) picked = nil end
        cfgSec:AddButton({ Name = "Save config", Callback = function()
            local name = nameBox:Get()
            if name == "settings" then Library:Notify("Configs", "That name is reserved. Pick another one.", "Warning") return end
            if saveConfig(name) then refresh() listDrop:Set(name, true) picked = name Library:Notify("Config saved", name .. " was saved.", "Success") end
        end })
        cfgSec:AddButton({ Name = "Load config", Callback = function()
            if loadConfig(picked) then Library:Notify("Config loaded", picked .. " is now active.", "Success") end
        end })
        cfgSec:AddButton({ Name = "Delete config", Callback = function()
            if not picked then Library:Notify("Configs", "Pick a saved config first.", "Warning") return end
            if typeof(delfile) == "function" then pcall(delfile, hubFolder .. "/" .. picked .. ".json") end
            Library:Notify("Config deleted", picked .. " was removed.", "Info")
            refresh()
        end })
        cfgSec:AddButton({ Name = "Refresh list", Callback = refresh })
        local autoPath = hubFolder .. "/autoload.txt"
        cfgSec:AddToggle({ Name = "Load on start", Description = "Loads the selected config next time", NoSave = true,
            Default = canSave and isfile(autoPath) or false,
            Callback = function(on)
                if not canSave then return end
                ensure(hubFolder)
                if on then
                    if not picked then Library:Notify("Configs", "Pick a saved config first.", "Warning") return end
                    writefile(autoPath, picked)
                elseif isfile(autoPath) and typeof(delfile) == "function" then pcall(delfile, autoPath) end
            end })

        if not Window.IsMobile then
            local menu = tab:Section("Menu", "Left")
            menu:AddKeybind({ Name = "Show / hide menu", Default = Window.ToggleKey, Changed = function(k)
                Window.ToggleKey = k
                if k then Library:Notify("Menu key", "Press " .. keyName(k) .. " to show or hide the menu.", "Info")
                else Library:Notify("Menu key", "No key set. Click the box to pick one.", "Warning") end
            end })
        end

        local hop = tab:Section("Server hop", "Right")
        hop:AddToggle({ Name = "Reload on teleport", Description = "Opens the menu again after you join a new server", NoSave = true, Default = Window.ReloadOnTeleport,
            Callback = function(on)
                Window.ReloadOnTeleport = on
                storeSetting("Reload", on)
                if on and not cfg.Reload then
                    Library:Notify("Server hop", "Add Reload to your window settings to use this.", "Warning")
                elseif on and not Window.CanReload then
                    Library:Notify("Server hop", "Your executor can't queue scripts on teleport.", "Warning")
                else
                    Library:Notify("Server hop", on and "The menu will reload after a teleport." or "The menu won't reload after a teleport.", "Info")
                end
            end })

        if Window.IsMobile then
            local mob = tab:Section("Mobile", "Right")
            local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(mob.Body), Parent = mob.Body }, { list(10) })
            titleBlock(holder, "Open button", "Tap it to hide or show the menu").LayoutOrder = 1
            local hint
            local seg
            seg = segmented(holder, { "Top bar", "Floating" }, 2, function(n)
                Window:SetMobileButton(n)
                storeSetting("MobileButton", n)
                seg:Set(n)
                hint.Text = n == "Top bar" and "A button with your hub name sits next to the Roblox menu button." or "A small box with your hub name at the top of the screen. Drag it anywhere."
            end)
            hint = textNote(holder, "", 3)
            seg:Set(Window.MobileButton)
            hint.Text = Window.MobileButton == "Top bar" and "A button with your hub name sits next to the Roblox menu button." or "A small box with your hub name at the top of the screen. Drag it anywhere."
            register({ Window = Window, Page = tab.Page, Section = "Mobile" }, "Open button", holder)
        end

        for i = #Window.Switches, 1, -1 do if Window.Switches[i].Frame and Window.Switches[i].Frame:IsDescendantOf(tab.Page.Group) then table.remove(Window.Switches, i) end end

        local themeTab = builtIn("Theme", 2)
        themeTab.Page.NoSave = true
        local ap = Library.Appearance

        local appSec = themeTab:Section("Appearance", "Left")
        local builder = themeTab:Section("Theme builder", "Left")
        local refreshBuilder
        local modeDrop = appSec:AddDropdown({ Name = "Theme", Options = MODE_LIST, Default = ap.Mode, NoSave = true, Callback = function(v)
            if v == "Custom" and THEME_PRESETS[ap.Mode] then ap.Custom = table.clone(THEME_PRESETS[ap.Mode]) end
            Library:SetAppearance(v)
            refreshBuilder()
        end })

        local pending = false
        local function liveApply()
            if pending then return end
            pending = true
            task.delay(0.05, function() pending = false Library:SetAppearance("Custom") end)
        end
        local function setCustom(k, v, now)
            ap.Custom[k] = v
            if now then Library:SetAppearance("Custom") refreshBuilder() else liveApply() end
        end

        local body = builder.Body
        local ROLE_ROWS = { { "Window", "Window" }, { "Top", "Top bar" }, { "Side", "Sidebar" }, { "Section", "Section" }, { "Element", "Element" }, { "Outline", "Outline" }, { "Text", "Text" }, { "FadedText", "Faded text" }, { "Accent", "Accent" } }
        local colGroup = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(body), Parent = body }, { list(10) })
        smallLabel(colGroup, "Colours", 1)
        local colGrid = grid(colGroup, 2, math.ceil(#ROLE_ROWS / 2))
        local swatches = {}
        local function openFor(key, title, btnStroke)
            local before = ap.Custom[key]
            btnStroke.Color = Library.Theme.Accent
            Window:OpenColorPicker({
                Title = title, Default = fromHex(before) or Color3.new(1, 1, 1),
                Changed = function(c) setCustom(key, toHex(c):lower()) end,
                Done = function(c, _, applied)
                    btnStroke.Color = C.Stroke
                    setCustom(key, applied and toHex(c):lower() or before, true)
                end,
            })
        end
        for i, rr in ipairs(ROLE_ROWS) do
            local b, sw, st = swatchButton(colGrid, rr[2], i)
            swatches[rr[1]] = sw
            b.MouseButton1Click:Connect(function() openFor(rr[1], rr[2], st) end)
        end
        register({ Window = Window, Page = themeTab.Page, Section = "Theme builder" }, "Builder colours", colGroup)

        hline(body, nextOrder(body))
        local textGroup = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(body), Parent = body }, { list(10) })
        smallLabel(textGroup, "Text style", 1)
        local styleSeg = segmented(textGroup, { "Solid", "Gradient", "RGB" }, 2, function(n) setCustom("TextStyle", n, true) end)
        local gradHolder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Visible = false, Parent = textGroup }, { list(10) })
        local gGrid = grid(gradHolder, 1, 1)
        local secondBtn, secondSw, secondStroke = swatchButton(gGrid, "Second colour", 1)
        secondBtn.MouseButton1Click:Connect(function() openFor("SecondColor", "Second colour", secondStroke) end)
        local prevBox = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.new(0.5, -4, 0, 34), LayoutOrder = 2, Parent = gGrid }, { corner(5), stroke() })
        label({ Text = "Preview", TextSize = 13, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -52, 1, 0), Parent = prevBox })
        local prevSw = create("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(28, 20), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -7, 0.5, 0), Parent = prevBox }, { corner(4) })
        local prevGrad = create("UIGradient", { Parent = prevSw })
        local dirSlider = Elements.Slider(gradHolder, nil, { Name = "Direction", Min = 0, Max = 360, Increment = 5, Default = 90, Suffix = "°", Callback = function(v) setCustom("Direction", v) end })
        dirSlider.Frame.LayoutOrder = 2

        hline(body, nextOrder(body))
        local winGroup = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(body), Parent = body }, { list(10) })
        smallLabel(winGroup, "Window", 1)
        local alphaSlider = Elements.Slider(winGroup, nil, { Name = "Transparency", Min = 0, Max = 90, Default = 0, Suffix = "%", Callback = function(v) setCustom("Transparency", v) end })
        alphaSlider.Frame.LayoutOrder = 2

        hline(body, nextOrder(body))
        local fileGroup = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(body), Parent = body }, { list(10) })
        local fileHead = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1, Parent = fileGroup })
        smallLabel(fileHead, "Theme file", 0).Size = UDim2.new(0.45, 0, 1, 0)
        label({ Text = themeFolder, Font = Enum.Font.Code, TextSize = 11, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.45, 0), Size = UDim2.new(0.55, 0, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = fileHead })
        local fileBtns = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 2, Parent = fileGroup })
        local exportBtn = styledButton(fileBtns, "Export theme", 0)
        exportBtn.Size = UDim2.new(0.5, -4, 1, 0)
        local importBtn = styledButton(fileBtns, "Import theme", 0)
        importBtn.Size, importBtn.Position = UDim2.new(0.5, -4, 1, 0), UDim2.new(0.5, 4, 0, 0)

        local filePanel = create("Frame", { BackgroundColor3 = C.Element, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false, LayoutOrder = 3, Parent = fileGroup }, { corner(6), stroke(), pad(10), list(8) })
        local fpHead = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Parent = filePanel })
        label({ Text = themeFolder, Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.SubText, Size = UDim2.new(1, -30, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = fpHead })
        local fpClose = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Hover, BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = fpHead }, { corner(4) })
        drawX(fpClose, C.Muted, 8)
        fpClose.MouseEnter:Connect(function() tween(fpClose, 0.12, { BackgroundTransparency = 0 }) end)
        fpClose.MouseLeave:Connect(function() tween(fpClose, 0.12, { BackgroundTransparency = 1 }) end)
        local FILE_MAX = 5 * 28 + 4 * 2
        local fpList = create("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 28), CanvasSize = UDim2.new(), ScrollBarThickness = 0, ScrollBarImageColor3 = C.Stroke,
            ScrollingDirection = Enum.ScrollingDirection.Y, VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar, ElasticBehavior = Enum.ElasticBehavior.Never, LayoutOrder = 2, Parent = filePanel })
        local fpLayout = list(2)
        fpLayout.Parent = fpList
        local fpEmpty = label({ Text = "No theme files yet.", TextSize = 12, TextColor3 = C.Muted, Size = UDim2.new(1, 0, 0, 28), Visible = false, LayoutOrder = 3, Parent = filePanel })
        local saveRow = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), Visible = false, LayoutOrder = 4, Parent = filePanel })
        local fileName = create("TextBox", { Text = "Custom", PlaceholderText = "File name", ClearTextOnFocus = false, Font = FONT, TextSize = 12, TextColor3 = C.Text, PlaceholderColor3 = C.Faint, TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundColor3 = C.Card, Size = UDim2.new(1, -78, 1, 0), Parent = saveRow }, { corner(4), stroke(), pad(0, 10, 0, 10) })
        local saveBtn = create("TextButton", { AutoButtonColor = false, Text = "Save", Font = FONT_BOLD, TextSize = 12, TextColor3 = C.Dark, BackgroundColor3 = Library.Theme.Accent, Size = UDim2.new(0, 70, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = saveRow }, { corner(4) })
        bindTheme(function(t) if not saveBtn.Parent then error("gone") end saveBtn.BackgroundColor3 = t.Accent end)

        local fileMode
        local fileRows = {}
        local function readTheme(n)
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(themeFolder .. "/" .. n .. ".json")) end)
            if not ok or typeof(data) ~= "table" then return nil end
            local cu = table.clone(CUSTOM_DEFAULT)
            for k, v in pairs(data) do if CUSTOM_DEFAULT[k] ~= nil then cu[k] = v end end
            return cu
        end
        local function fillFiles()
            for _, r in ipairs(fileRows) do r:Destroy() end
            table.clear(fileRows)
            local names = listJson(themeFolder)
            for i, n in ipairs(names) do
                local r = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Active, BackgroundTransparency = (fileMode == "save" and fileName.Text == n) and 0 or 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = i, Parent = fpList }, { corner(4) })
                label({ Text = n .. ".json", TextSize = 12, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -80, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = r })
                label({ Text = fileMode == "save" and "Overwrite" or "Load", TextSize = 11, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.new(0, 70, 1, 0), Parent = r })
                r.MouseEnter:Connect(function() tween(r, 0.12, { BackgroundTransparency = 0.5 }) end)
                r.MouseLeave:Connect(function() tween(r, 0.12, { BackgroundTransparency = (fileMode == "save" and fileName.Text == n) and 0 or 1 }) end)
                r.MouseButton1Click:Connect(function()
                    if fileMode == "save" then fileName.Text = n fillFiles() return end
                    local cu = readTheme(n)
                    if not cu then Library:Notify("Import failed", n .. ".json isn't a theme file.", "Error") return end
                    ap.Custom = cu
                    Library:SetAppearance("Custom")
                    modeDrop:Set("Custom", true)
                    refreshBuilder()
                    filePanel.Visible = false
                    fileMode = nil
                    Library:Notify("Theme imported", "Loaded " .. n .. ".json.", "Success")
                end)
                table.insert(fileRows, r)
            end
            local h = math.max(0, #names * 28 + math.max(0, #names - 1) * 2)
            fpList.CanvasSize = UDim2.fromOffset(0, h)
            fpList.Size = UDim2.new(1, 0, 0, math.min(h, FILE_MAX))
            fpList.ScrollBarThickness = h > FILE_MAX and 3 or 0
            fpList.Visible = #names > 0
            fpEmpty.Visible = #names == 0
        end
        local function openFiles(kind)
            if not canSave then Library:Notify("Theme file", "Your executor can't use files.", "Error") return end
            if fileMode == kind then fileMode = nil filePanel.Visible = false return end
            fileMode = kind
            saveRow.Visible = kind == "save"
            filePanel.Visible = true
            fillFiles()
        end
        exportBtn.MouseButton1Click:Connect(function() openFiles("save") end)
        importBtn.MouseButton1Click:Connect(function() openFiles("load") end)
        fpClose.MouseButton1Click:Connect(function() fileMode = nil filePanel.Visible = false end)
        saveBtn.MouseButton1Click:Connect(function()
            local n = fileName.Text:gsub("[\\/:%*%?\"<>|]", ""):gsub("^%s+", ""):gsub("%s+$", "")
            if n == "" then Library:Notify("Export failed", "Type a file name first.", "Warning") return end
            ensure(themeFolder)
            local ok = pcall(writefile, themeFolder .. "/" .. n .. ".json", HttpService:JSONEncode(ap.Custom))
            if not ok then Library:Notify("Export failed", "Couldn't write the theme file.", "Error") return end
            fileMode = nil
            filePanel.Visible = false
            Library:Notify("Theme exported", "Saved to " .. themeFolder .. "/" .. n .. ".json.", "Success")
        end)
        table.insert(Window.Popups, function() if fileMode then fileMode = nil filePanel.Visible = false end end)

        refreshBuilder = function()
            local cu = ap.Custom
            builder.Frame.Visible = ap.Mode == "Custom"
            for k, sw in pairs(swatches) do sw.BackgroundColor3 = fromHex(cu[k]) or Color3.new(1, 1, 1) end
            secondSw.BackgroundColor3 = fromHex(cu.SecondColor) or Color3.new(1, 1, 1)
            prevGrad.Color = ColorSequence.new(fromHex(cu.Text) or Color3.new(1, 1, 1), fromHex(cu.SecondColor) or Color3.new(1, 1, 1))
            prevGrad.Rotation = (tonumber(cu.Direction) or 90) - 90
            styleSeg:Set(cu.TextStyle or "Solid")
            gradHolder.Visible = cu.TextStyle == "Gradient"
            dirSlider:Set(tonumber(cu.Direction) or 90, true)
            alphaSlider:Set(tonumber(cu.Transparency) or 0, true)
        end
        refreshBuilder()

        local resetSec = themeTab:Section("Reset", "Left")
        resetSec:AddParagraph({ Title = "Default theme", Content = "Go back to the default Dark theme and pink accent." })

        local colours = themeTab:Section("Colours", "Right")
        for _, row in ipairs({ { "Accent", "Accent" }, { "Streak colour", "Streak" }, { "Streak tip", "StreakTip" }, { "Streak tail", "StreakTail" } }) do
            local key = row[2]
            local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = nextOrder(colours.Body), Parent = colours.Body })
            label({ Text = row[1], TextSize = 14, Size = UDim2.new(1, -56, 0, 22), Parent = wrap })
            local prevBtn = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = Library.Theme[key], Size = UDim2.fromOffset(42, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = wrap }, { corner(5) })
            local prevStroke = stroke() prevStroke.Parent = prevBtn
            prevBtn.MouseButton1Click:Connect(function()
                local before = Library.Theme[key]
                prevStroke.Color = Library.Theme.Accent
                Window:OpenColorPicker({
                    Title = row[1], Default = before,
                    Changed = function(c) Library:SetTheme(key, c) end,
                    Done = function(c, _, applied)
                        prevStroke.Color = C.Stroke
                        Library:SetTheme(key, applied and c or before)
                        if key == "Accent" and ap.Mode == "Custom" then ap.Custom.Accent = toHex(Library.Theme.Accent):lower() refreshBuilder() end
                    end,
                })
            end)
            local swRow = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 30), Parent = wrap },
                { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
            local strokes = {}
            for i, col in ipairs(PRESETS) do
                local b = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = col, Size = UDim2.fromOffset(22, 22), LayoutOrder = i, Parent = swRow }, { corner(11) })
                local ring = Instance.new("UIStroke")
                ring.Thickness, ring.Color, ring.Parent = 2, C.Stroke, b
                strokes[i] = { S = ring, C = col }
                b.MouseButton1Click:Connect(function()
                    Library:SetTheme(key, col)
                    if key == "Accent" and ap.Mode == "Custom" then ap.Custom.Accent = toHex(col):lower() refreshBuilder() end
                end)
            end
            bindTheme(function(t)
                if not wrap.Parent then error("gone") end
                prevBtn.BackgroundColor3 = t[key]
                for _, st in ipairs(strokes) do st.S.Color = (toHex(st.C) == toHex(t[key])) and C.Text or C.Stroke end
            end)
            register({ Window = Window, Page = themeTab.Page, Section = "Colours" }, row[1], wrap)
        end

        local border = themeTab:Section("Border line", "Right")
        local linesT = border:AddToggle({ Name = "Gradient lines", Description = "Streaks travelling around the edge", Default = Library.Theme.Lines, NoSave = true, Callback = function(v) Library:SetTheme("Lines", v) end })
        local lapS = border:AddSlider({ Name = "Lap time", Min = 3, Max = 16, Default = Library.Theme.LapTime, Suffix = "s", NoSave = true, Callback = function(v) Library:SetTheme("LapTime", v) end })
        local bg = themeTab:Section("Background", "Right")
        local modeD = bg:AddDropdown({ Name = "Dot mode", Options = { "Twinkle", "Follow cursor", "Wave", "Scattered wave", "Off" }, Default = Library.Theme.DotMode, NoSave = true, Callback = function(v) Library:SetTheme("DotMode", v) end })

        local function syncControls()
            linesT:Set(Library.Theme.Lines, true)
            lapS:Set(Library.Theme.LapTime, true)
            modeD:Set(Library.Theme.DotMode, true)
            modeDrop:Set(ap.Mode, true)
            refreshBuilder()
        end
        table.insert(afterLoad, syncControls)
        resetSec:AddButton({ Name = "Reset to default", Callback = function()
            Library:ResetTheme()
            syncControls()
            Library:Notify("Theme reset", "Back to the default Dark theme.", "Success")
        end })
        for i = #Window.Switches, 1, -1 do
            local f = Window.Switches[i].Frame
            if f and f:IsDescendantOf(themeTab.Page.Group) then table.remove(Window.Switches, i) end
        end

        task.delay(1, function()
            if canSave and isfile(autoPath) then
                local name = readfile(autoPath)
                if loadConfig(name) then
                    picked = name
                    listDrop:Set(name, true)
                    Library:Notify("Config loaded", name .. " was loaded automatically.", "Info")
                end
            end
        end)
        Window.SaveConfig, Window.LoadConfig = function(_, n) return saveConfig(n) end, function(_, n) return loadConfig(n) end
        return tab
    end
    Window.AddStatsTab, Window.AddSettingsTab = Window.Stats, Window.Settings

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Window(title, toggleKey, extra)
    if typeof(title) == "table" then return self:CreateWindow(title) end
    local cfg = { Title = title, ToggleKey = toggleKey }
    if typeof(extra) == "table" then for k, v in pairs(extra) do cfg[k] = v end end
    return self:CreateWindow(cfg)
end

return Library
