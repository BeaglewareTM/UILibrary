    local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder(parent), Parent = parent }, { list(0) })
    local row = create("TextButton", { AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, cfg.Description and 36 or 26), LayoutOrder = 1, Parent = wrap })
    local right = create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, Parent = row },
        { create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
    local tb = titleBlock(row, cfg.Name or "Toggle", cfg.Description, cfg.Keybind and 116 or 58)
    tb.Position = UDim2.new(0, 0, 0.5, cfg.Description and -17 or -9)
    local sw = makeSwitch(right)
    sw.Frame.LayoutOrder = 1
    hookPress(row, sw)

    local obj = { Frame = wrap }
    local reveal
    if cfg.Slider or cfg.Dropdown then
        reveal = collapsible(wrap, state, 2)
        local holder = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = reveal.Inner }, { pad(10, 1, 2, 1), list(10) })
        if cfg.Slider then obj.Slider = Elements.Slider(holder, nil, cfg.Slider) end
        if cfg.Dropdown then
            local d = table.clone(cfg.Dropdown)
            d.HideName = d.Name == nil
            obj.Dropdown = Elements.Dropdown(holder, nil, d)
        end
    end
    function obj:Set(v, silent)
        state = v
        sw.On = v sw:Layout()
        if reveal then
            reveal:Set(v)
            if not v and obj.Dropdown then obj.Dropdown:Toggle(false) end
        end
        if not silent then
            if cfg.Callback then task.spawn(cfg.Callback, v) end
            fireNotify(cfg.Notify, v and "on" or "off", v)
        end
    end
    function obj:Get() return state end
    if cfg.Keybind then
        local badge = keyBadge(right, typeof(cfg.Keybind) == "EnumItem" and cfg.Keybind or nil, cfg.KeybindChanged)
        badge.Frame.LayoutOrder = 2
        obj.Keybind = badge
        table.insert(keyListeners, { Window = ctx and ctx.Window, Key = function() return badge:Get() end, Fn = function() obj:Set(not state) end })
    end
    row.MouseButton1Click:Connect(function() obj:Set(not state) end)
    sw.On = state sw:Layout(true)
    register(ctx, cfg.Name, wrap)
    if ctx and ctx.Window then table.insert(ctx.Window.Switches, obj) end
    if cfg.Flag then Library.Flags[cfg.Flag] = obj end
    savable(ctx, cfg, obj, "bool")
    return obj
end

