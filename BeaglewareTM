    function Window:Tab(name, iconName)
        local tcfg = typeof(name) == "table" and name or { Name = name, Icon = iconName }
        local Tab = { Name = tcfg.Name or "Tab", SubTabs = {} }
        local wrap = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = tcfg.Order or (#Window.Tabs + 1), Parent = sidebar }, { list(0) })
        local btn, txt = navButton(wrap, Tab.Name, nil, false, 1)
        local arrow
        local subs = collapsible(wrap, false, 2)
        local subList = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = subs.Inner }, { pad(2, 0, 6, 18), list(1) })
        local guide = create("Frame", { BackgroundColor3 = C.Stroke, BorderSizePixel = 0, Size = UDim2.new(0, 1, 1, -8), Position = UDim2.fromOffset(8, 2), Visible = false, ZIndex = 2, Parent = subs.Clip })
        Tab.Page = makePage(Tab.Name)
        Tab.Expanded = true

        local function isActive() return Window.Current == Tab.Page end
        local function childActive() for _, s in ipairs(Tab.SubTabs) do if Window.Current == s.Page then return true end end return false end
        table.insert(navButtons, { Paint = function()
            local on = isActive() or (childActive() and not Tab.Expanded)
            local strong = on or childActive()
            tween(btn, 0.2, { BackgroundTransparency = on and 0 or 1 })
            tween(txt, 0.2, { TextColor3 = strong and C.Text or C.SubText })
            txt.Font = strong and FONT_BOLD or FONT_MED
        end })
        btn.MouseEnter:Connect(function() if not isActive() then tween(btn, 0.15, { BackgroundTransparency = 0.6 }) end end)
        btn.MouseLeave:Connect(function() paintNav() end)
        btn.MouseButton1Click:Connect(function()
            if #Tab.SubTabs > 0 then
                Tab.Expanded = not Tab.Expanded
                subs:Set(Tab.Expanded)
                tween(arrow, 0.25, { Rotation = Tab.Expanded and 0 or -90 })
                paintNav()
            else
                selectPage(Tab.Page)
            end
        end)

        function Tab:Section(sname, side, open)
            if typeof(sname) == "table" then return buildSection(Tab.Page, Tab, sname) end
            return buildSection(Tab.Page, Tab, { Name = sname, Side = side, Open = open })
        end
        Tab.CreateSection = function(_, s) return Tab:Section(s) end

        function Tab:SubTab(sname, sorder)
            local Sub = { Name = sname, Parent = Tab, Order = sorder or (#Tab.SubTabs + 1) }
            if not arrow then
                arrow = chevron(btn, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0) })
                arrow.Rotation = Tab.Expanded and 0 or -90
                guide.Visible = true
            end
            local sbtn, stxt = navButton(subList, sname, nil, true, sorder or (#Tab.SubTabs + 1))
            Sub.Page = makePage(sname)
            Sub.Page.Parent = Tab
            table.insert(navButtons, { Paint = function()
                local on = Window.Current == Sub.Page
                tween(sbtn, 0.2, { BackgroundTransparency = on and 0 or 1 })
                tween(stxt, 0.2, { TextColor3 = on and C.Text or C.Muted })
                stxt.Font = on and FONT_MED or FONT
            end })
            sbtn.MouseEnter:Connect(function() if Window.Current ~= Sub.Page then tween(sbtn, 0.15, { BackgroundTransparency = 0.6 }) end end)
            sbtn.MouseLeave:Connect(function() paintNav() end)
            sbtn.MouseButton1Click:Connect(function() selectPage(Sub.Page) end)
            function Sub:Section(n, side, open)
                if typeof(n) == "table" then return buildSection(Sub.Page, Sub, n) end
                return buildSection(Sub.Page, Sub, { Name = n, Side = side, Open = open })
            end
            Sub.CreateSection = function(_, s) return Sub:Section(s) end
            function Sub:Select() selectPage(Sub.Page) end
            table.insert(Tab.SubTabs, Sub)
            task.defer(function() subs:Set(Tab.Expanded, true) end)
            table.sort(Tab.SubTabs, function(a, b) return (a.Order or 0) < (b.Order or 0) end)

            if Window.Current == Tab.Page then task.defer(function() selectPage(Tab.SubTabs[1].Page) end) end
            paintNav()
            return Sub
        end
        function Tab:Expand()
            if Tab.Expanded or not arrow then return end
            Tab.Expanded = true
            subs:Set(true)
            tween(arrow, 0.25, { Rotation = 0 })
            paintNav()
        end
        function Tab:Select()
            if #Tab.SubTabs > 0 then selectPage(Tab.SubTabs[1].Page) else selectPage(Tab.Page) end
        end

        table.insert(Window.Tabs, Tab)
        if #Window.Tabs == 1 then task.defer(function() if not Window.Current then Tab:Select() end end) end
        return Tab
    end
    Window.CreateTab = Window.Tab

