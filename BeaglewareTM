    local dotLayer = create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = content })
    local dots, GAP = {}, 18
    local cols, rows = math.floor(CW / GAP), math.floor(CH / GAP)
    do
        local rng = Random.new(42)
        local offX, offY = math.floor((CW - cols * GAP) / 2), math.floor((CH - rows * GAP) / 2)
        for cy = 0, rows - 1 do
            for cx = 0, cols - 1 do
                local x, y = offX + cx * GAP + GAP / 2, offY + cy * GAP + GAP / 2
                local f = create("Frame", { BackgroundColor3 = Library.Theme.Accent, BackgroundTransparency = 0.86, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(2, 2), ZIndex = 1, Parent = dotLayer }, { corner(2) })
                table.insert(dots, { F = f, X = x, Y = y, Cx = cx, A = 0, Scatter = rng:NextNumber() < 0.22, Delay = rng:NextNumber() * 1.4 })
            end
        end
    end
    local function setDot(d, a)
        if math.abs(a - d.A) < 0.03 then return end
        d.A = a
        local t = Library.Theme
        d.F.BackgroundTransparency = 0.86 - 0.86 * a
        d.F.Size = UDim2.fromOffset(2 + 2 * a, 2 + 2 * a)
        d.F.BackgroundColor3 = t.Accent:Lerp(t.StreakTip, a)
    end
